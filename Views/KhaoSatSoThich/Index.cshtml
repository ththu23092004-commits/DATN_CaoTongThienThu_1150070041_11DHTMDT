
@model VeSuKienWeb.Models.KhaoSatSoThich.KhaoSatSoThichVM

@{
    ViewData["Title"] = "Khám phá sở thích sự kiện";

    var chuDes = ViewBag.ChuDes as List<VeSuKienWeb.Models.ChuDeSuKien>
        ?? new List<VeSuKienWeb.Models.ChuDeSuKien>();

    var soChuDeDaChon = Model?.ChuDeIds?.Count ?? 0;
    var hinhThuc = Model?.HinhThucUuTien ?? "KhongGioiHan";
}

<div class="survey-page">
    <div class="survey-container">

        <div class="survey-heading">
            <div class="survey-heading-line"></div>

            <h1>Khám phá sự kiện dành riêng cho bạn</h1>

            <p>
                Mỗi người có một sở thích riêng. Hãy chia sẻ đôi chút về
                những điều bạn quan tâm để chúng tôi tìm ra những sự kiện
                phù hợp với bạn.
            </p>

            <div class="survey-progress">
                <span class="progress-line"></span>
                <span class="progress-active">01. Sở thích</span>
                <span class="progress-dot"></span>
                <span>02. Cá nhân hóa</span>
                <span class="progress-dot"></span>
                <span>03. Gợi ý sự kiện</span>
            </div>
        </div>

        <form asp-controller="KhaoSatSoThich"
              asp-action="Index"
              method="post"
              id="surveyForm">

            @Html.AntiForgeryToken()

            <!-- PHẦN 01: CHỦ ĐỀ YÊU THÍCH -->
            <section class="survey-section">

                <div class="section-heading">
                    <div class="section-number">01</div>

                    <div class="section-title">
                        <h2>Bạn quan tâm đến chủ đề nào?</h2>
                        <p>Chọn những lĩnh vực bạn yêu thích. Bạn có thể chọn nhiều chủ đề.</p>
                    </div>
                </div>

                <div class="topic-selection-info">
                    Đã chọn <strong id="selectedTopicCount">@soChuDeDaChon</strong> chủ đề
                </div>

                <div class="topic-grid">

                    @foreach (var item in chuDes)
                    {
                        var selected = Model?.ChuDeIds?.Contains(item.ChuDeId) ?? false;

                        <label class="topic-card @(selected ? "selected" : "")"
                               for="topic-@item.ChuDeId">

                            <input type="checkbox"
                                   class="topic-input"
                                   id="topic-@item.ChuDeId"
                                   name="ChuDeIds"
                                   value="@item.ChuDeId"
                                   checked="@selected" />

                            <span class="topic-content">
                                <strong>@item.TenChuDe</strong>
                                <small>@item.MoTa</small>
                            </span>

                        </label>
                    }

                </div>

                <span asp-validation-for="ChuDeIds"
                      class="validation-message"></span>

                <div class="section-note">
                    Bạn có thể chọn nhiều chủ đề để nhận được gợi ý đa dạng hơn.
                </div>

            </section>

            <!-- PHẦN 02: ĐỊA ĐIỂM -->
            <section class="survey-section">

                <div class="section-heading">
                    <div class="section-number">02</div>

                    <div class="section-title">
                        <h2>Bạn muốn tham gia sự kiện ở đâu?</h2>
                        <p>Cho chúng tôi biết địa điểm ưu tiên để tìm sự kiện thuận tiện hơn.</p>
                    </div>
                </div>

                <input asp-for="DiaDiemUuTien"
                       class="survey-input"
                       placeholder="Ví dụ: TP. Hồ Chí Minh, Hà Nội, Đà Nẵng..." />

                <div class="section-note">
                    Địa điểm giúp hệ thống ưu tiên các sự kiện gần nơi bạn quan tâm.
                </div>

            </section>

            <!-- PHẦN 03: HÌNH THỨC TỔ CHỨC -->
            <section class="survey-section">

                <div class="section-heading">
                    <div class="section-number">03</div>

                    <div class="section-title">
                        <h2>Bạn thích hình thức tổ chức nào?</h2>
                        <p>Chọn hình thức tham gia phù hợp với nhu cầu của bạn.</p>
                    </div>
                </div>

                <div class="format-options">

                    <label class="format-card">
                        <input type="radio"
                               name="HinhThucUuTien"
                               value="KhongGioiHan"
                               id="format-all"
                               checked="@(hinhThuc == "KhongGioiHan")" />

                        <span class="format-content">
                            <strong>Không giới hạn</strong>
                            <small>Quan tâm đến tất cả hình thức tổ chức.</small>
                        </span>
                    </label>

                    <label class="format-card">
                        <input type="radio"
                               name="HinhThucUuTien"
                               value="TrucTiep"
                               id="format-direct"
                               checked="@(hinhThuc == "TrucTiep")" />

                        <span class="format-content">
                            <strong>Trực tiếp</strong>
                            <small>Tham gia tại địa điểm tổ chức.</small>
                        </span>
                    </label>

                    <label class="format-card">
                        <input type="radio"
                               name="HinhThucUuTien"
                               value="TrucTuyen"
                               id="format-online"
                               checked="@(hinhThuc == "TrucTuyen")" />

                        <span class="format-content">
                            <strong>Trực tuyến</strong>
                            <small>Tham gia sự kiện qua Internet.</small>
                        </span>
                    </label>

                    <label class="format-card">
                        <input type="radio"
                               name="HinhThucUuTien"
                               value="Hybrid"
                               id="format-hybrid"
                               checked="@(hinhThuc == "Hybrid")" />

                        <span class="format-content">
                            <strong>Kết hợp (Hybrid)</strong>
                            <small>Sự kiện có cả hình thức trực tiếp và trực tuyến.</small>
                        </span>
                    </label>

                </div>

                <span asp-validation-for="HinhThucUuTien"
                      class="validation-message"></span>

            </section>

            <!-- NÚT LƯU -->
            <div class="survey-actions">

                <p class="survey-privacy">
                    Sở thích của bạn được sử dụng để cá nhân hóa danh sách gợi ý sự kiện.
                </p>

                <button type="submit" class="survey-submit">
                    Lưu sở thích và tiếp tục
                    <span>→</span>
                </button>

                <p class="survey-footer-text">
                    Bạn có thể thay đổi sở thích bất cứ lúc nào trong tài khoản.
                </p>

            </div>

        </form>

    </div>
</div>

<style>
    .survey-page {
        --event-blue: #1671d8;
        --event-blue-dark: #105bb1;
        --event-blue-light: #edf5ff;
        --event-border: #dce6f2;
        --event-text: #243247;
        --event-muted: #718096;

        background: #f5f8fc;
        min-height: 100vh;
        padding: 36px 18px 55px;
        color: var(--event-text);
        font-family: inherit;
    }

    .survey-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .survey-heading {
        max-width: 760px;
        text-align: center;
        margin: 0 auto 30px;
    }

    .survey-heading-line {
        width: 42px;
        height: 4px;
        background: var(--event-blue);
        border-radius: 10px;
        margin: 0 auto 19px;
    }

    .survey-heading h1 {
        font-size: clamp(27px, 3vw, 34px);
        font-weight: 750;
        line-height: 1.3;
        margin: 0 0 12px;
        color: #172b46;
    }

    .survey-heading > p {
        max-width: 690px;
        margin: 0 auto;
        color: var(--event-muted);
        font-size: 15px;
        line-height: 1.75;
    }

    .survey-progress {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 23px;
        color: #8793a3;
        font-size: 12px;
    }

    .progress-line {
        width: 27px;
        height: 3px;
        border-radius: 5px;
        background: var(--event-blue);
    }

    .progress-active {
        color: var(--event-blue);
        font-weight: 700;
    }

    .progress-dot {
        width: 5px;
        height: 5px;
        background: #cbd6e3;
        border-radius: 50%;
    }

    .survey-section {
        background: #fff;
        border: 1px solid var(--event-border);
        border-radius: 16px;
        padding: 25px 26px;
        margin-bottom: 17px;
        box-shadow: 0 4px 18px rgba(37, 75, 120, .035);
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 19px;
    }

    .section-number {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 12px;
        background: var(--event-blue-light);
        color: var(--event-blue);
        font-weight: 800;
        font-size: 15px;
    }

    .section-title {
        flex: 1;
        min-width: 0;
    }

    .section-title h2 {
        font-size: 19px;
        font-weight: 750;
        color: #233650;
        margin: 0 0 5px;
    }

    .section-title p {
        font-size: 13px;
        line-height: 1.6;
        color: var(--event-muted);
        margin: 0;
    }

    .topic-selection-info {
        margin-bottom: 13px;
        color: var(--event-muted);
        font-size: 13px;
    }

    .topic-selection-info strong {
        color: var(--event-blue);
        font-size: 15px;
    }

    .topic-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .topic-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 82px;
        padding: 14px;
        border: 1px solid var(--event-border);
        border-radius: 11px;
        background: #fff;
        cursor: pointer;
        transition: .2s ease;
    }

    .topic-card:hover {
        border-color: #86b7ed;
        background: #f8fbff;
        transform: translateY(-1px);
    }

    .topic-card.selected {
        border-color: var(--event-blue);
        background: #f0f6ff;
        box-shadow: 0 3px 12px rgba(22, 113, 216, .07);
    }

    .topic-input {
        appearance: none;
        -webkit-appearance: none;
        width: 21px;
        height: 21px;
        flex-shrink: 0;
        margin: 0;
        border: 1.5px solid #b7c5d6;
        border-radius: 6px;
        background: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: .2s;
    }

    .topic-input:checked {
        background: var(--event-blue);
        border-color: var(--event-blue);
    }

    .topic-input:checked::after {
        content: "✓";
        color: white;
        font-size: 13px;
        font-weight: 800;
    }

    .topic-input:focus-visible {
        outline: 3px solid rgba(22, 113, 216, .2);
        outline-offset: 3px;
    }

    .topic-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

    .topic-content strong {
        font-size: 15px;
        color: #293b53;
        font-weight: 700;
        line-height: 1.5;
    }

    .topic-content small {
        color: var(--event-muted);
        font-size: 13px;
        line-height: 1.55;
    }

    .section-note {
        margin-top: 15px;
        color: #8390a0;
        font-size: 12px;
        line-height: 1.6;
    }

    .survey-input {
        width: 100%;
        min-height: 48px;
        border: 1px solid var(--event-border);
        border-radius: 10px;
        padding: 12px 15px;
        background: #fff;
        color: var(--event-text);
        font-size: 14px;
        outline: none;
        transition: .2s;
    }

    .survey-input:focus {
        border-color: var(--event-blue);
        box-shadow: 0 0 0 3px rgba(22, 113, 216, .08);
    }

    .survey-input::placeholder {
        color: #a1adbb;
    }

    .format-options {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .format-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 77px;
        padding: 15px;
        border: 1px solid var(--event-border);
        border-radius: 11px;
        cursor: pointer;
        background: #fff;
        transition: .2s;
    }

    .format-card:hover {
        border-color: #86b7ed;
        background: #f8fbff;
    }

    .format-card:has(input:checked) {
        border-color: var(--event-blue);
        background: #f0f6ff;
        box-shadow: 0 3px 12px rgba(22, 113, 216, .07);
    }

    .format-card input {
        appearance: none;
        -webkit-appearance: none;
        width: 19px;
        height: 19px;
        flex-shrink: 0;
        margin: 0;
        border: 1.5px solid #b7c5d6;
        border-radius: 50%;
        background: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
    }

    .format-card input:checked {
        border: 5px solid var(--event-blue);
    }

    .format-card input:focus-visible {
        outline: 3px solid rgba(22, 113, 216, .2);
        outline-offset: 3px;
    }

    .format-content {
        display: flex;
        flex-direction: column;
        gap: 5px;
        flex: 1;
        min-width: 0;
    }

    .format-content strong {
        font-size: 15px;
        color: #293b53;
        font-weight: 700;
    }

    .format-content small {
        font-size: 13px;
        line-height: 1.5;
        color: var(--event-muted);
    }

    .survey-actions {
        text-align: center;
        padding: 17px 0 5px;
    }

    .survey-privacy {
        color: var(--event-muted);
        font-size: 13px;
        line-height: 1.6;
        margin: 0 0 17px;
    }

    .survey-submit {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 17px;
        min-width: 235px;
        padding: 14px 24px;
        border: none;
        border-radius: 9px;
        background: var(--event-blue);
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 5px 15px rgba(22, 113, 216, .18);
        transition: .2s;
    }

    .survey-submit:hover {
        background: var(--event-blue-dark);
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(22, 113, 216, .23);
    }

    .survey-submit span {
        font-size: 19px;
    }

    .survey-footer-text {
        margin: 13px 0 0;
        color: #8995a3;
        font-size: 12px;
    }

    .validation-message {
        display: block;
        color: #d33d3d;
        font-size: 13px;
        margin-top: 10px;
    }

    @@media (max-width: 650px) {
        .survey-page {
            padding: 25px 12px 38px;
        }

        .survey-heading {
            margin-bottom: 24px;
        }

        .survey-heading h1 {
            font-size: 26px;
        }

        .survey-heading > p {
            font-size: 13px;
        }

        .survey-progress {
            gap: 7px;
            font-size: 10px;
        }

        .survey-section {
            padding: 19px 15px;
            margin-bottom: 14px;
        }

        .section-heading {
            gap: 10px;
        }

        .section-number {
            width: 37px;
            height: 37px;
            font-size: 13px;
        }

        .section-title h2 {
            font-size: 16px;
        }

        .section-title p {
            font-size: 12px;
        }

        .topic-grid,
        .format-options {
            grid-template-columns: 1fr;
        }

        .topic-card {
            min-height: 75px;
            padding: 12px;
        }

        .topic-content strong,
        .format-content strong {
            font-size: 14px;
        }

        .topic-content small,
        .format-content small {
            font-size: 12px;
        }

        .survey-submit {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .survey-page *,
        .survey-page *::before,
        .survey-page *::after {
            transition: none !important;
            transform: none !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const topicInputs = document.querySelectorAll(".topic-input");
        const countElement = document.getElementById("selectedTopicCount");

        function updateTopics() {
            let count = 0;

            topicInputs.forEach(function (input) {
                const card = input.closest(".topic-card");

                if (input.checked) {
                    count++;
                    card.classList.add("selected");
                } else {
                    card.classList.remove("selected");
                }
            });

            if (countElement) {
                countElement.textContent = count;
            }
        }

        topicInputs.forEach(function (input) {
            input.addEventListener("change", updateTopics);
        });

        updateTopics();
    });
</script>
