<div class="usm-modal" id="usmLockModal" hidden>
    <div class="usm-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="usmLockTitle">

        <div class="usm-dialog-header">
            <div class="usm-dialog-icon lock"
                 id="usmLockIcon">
                <i class="bi bi-lock"></i>
            </div>

            <div>
                <h2 class="usm-dialog-title"
                    id="usmLockTitle">
                    Xác nhận khóa tài khoản
                </h2>

                <p class="usm-dialog-subtitle"
                   id="usmLockSubtitle">
                    Kiểm tra thông tin trước khi xác nhận.
