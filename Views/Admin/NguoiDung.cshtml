    </div>
</div>

<script>
(function () {
    "use strict";

    const rows = Array.from(
        document.querySelectorAll(".usm-row")
    );

    const statButtons = Array.from(
        document.querySelectorAll(".usm-stat")
    );

    const search = document.getElementById("usmSearch");
    const role = document.getElementById("usmRole");
    const status = document.getElementById("usmStatus");

    const empty = document.getElementById("usmEmpty");
    const info = document.getElementById("usmPageInfo");
    const pagination = document.getElementById("usmPagination");

    const editModal = document.getElementById("usmEditModal");
    const lockModal = document.getElementById("usmLockModal");
    const editForm = document.getElementById("usmEditForm");
    const lockForm = document.getElementById("usmLockForm");

    const pageSize = 8;
    let currentPage = 1;
    let activeStat = "all";
    let previousFocus = null;
    let submitting = false;

    const editBaseUrl = '@Url.Action("SuaNguoiDung", "Admin")';

    function byId(id) {
        return document.getElementById(id);
    }

    function put(id, value) {
        const element = byId(id);
        if (element) element.textContent = value ?? "";
    }

    function normalize(value) {
        return String(value ?? "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/g, "d")
            .replace(/Đ/g, "D")
            .toLocaleLowerCase("vi-VN")
            .trim();
    }

    function getRow(id) {
        return rows.find(row => row.dataset.id === String(id));
    }

    function getFilteredRows() {
        const keyword = normalize(search.value);

        return rows.filter(row => {
            const d = row.dataset;

            const text = normalize([
                d.name, d.email, d.phone
            ].join(" "));

            const matchKeyword =
                !keyword || text.includes(keyword);

            const matchRole =
                !role.value || d.role === role.value;

            const matchStatus =
                !status.value || d.status === status.value;

            const matchStat =
                activeStat === "all" ||
                (activeStat === "BiKhoa"
                    ? d.status === "BiKhoa"
                    : d.role === activeStat);

            return matchKeyword &&
                matchRole &&
                matchStatus &&
                matchStat;
        });
    }

    function createPageButton(label, target, active, disabled) {
        const button = document.createElement("button");

        button.type = "button";
        button.className =
            "usm-page-button" + (active ? " active" : "");

        button.textContent = label;
        button.disabled = disabled;

        if (active) {
            button.setAttribute("aria-current", "page");
        }

        button.addEventListener("click", () => {
            currentPage = target;
            render();
        });

        return button;
    }

    function render() {
        const matched = getFilteredRows();
        const pageCount = Math.max(
            1, Math.ceil(matched.length / pageSize)
        );

        currentPage = Math.min(currentPage, pageCount);

        rows.forEach(row => {
            row.hidden = true;
            row.style.display = "none";
        });

        const start = (currentPage - 1) * pageSize;
        const end = Math.min(start + pageSize, matched.length);

        matched.slice(start, end).forEach(row => {
            row.hidden = false;
            row.style.display = "";
        });

        empty.hidden = matched.length !== 0;

        info.textContent = matched.length
            ? `Hiển thị ${start + 1}–${end} / ${matched.length} tài khoản`
            : "Không có tài khoản phù hợp";

        pagination.replaceChildren();

        if (pageCount <= 1) return;

        pagination.appendChild(createPageButton(
            "Trước",
            Math.max(1, currentPage - 1),
            false,
            currentPage === 1
        ));

        for (let i = 1; i <= pageCount; i++) {
            pagination.appendChild(createPageButton(
                String(i), i, i === currentPage, false
            ));
        }

        pagination.appendChild(createPageButton(
            "Sau",
            Math.min(pageCount, currentPage + 1),
            false,
            currentPage === pageCount
        ));
    }

    function updateStatButtons() {
        statButtons.forEach(button => {
            const active = button.dataset.stat === activeStat;
            button.classList.toggle("active", active);
            button.setAttribute(
                "aria-pressed",
                active ? "true" : "false"
            );
        });
    }

    // BAM O THONG KE
    statButtons.forEach(button => {
        button.addEventListener("click", () => {
            const selected = button.dataset.stat;

            activeStat = selected;
            search.value = "";

            // Xóa bộ lọc cũ để không bị xung đột.
            role.value = "";
            status.value = "";

            currentPage = 1;
            updateStatButtons();
            render();
        });
    });

    function onFilterChange() {
        // Khi chủ động sử dụng bộ lọc, bỏ chế độ chọn thẻ.
        activeStat = "all";
        currentPage = 1;
        updateStatButtons();
        render();
    }

    search.addEventListener("input", onFilterChange);
    role.addEventListener("change", onFilterChange);
    status.addEventListener("change", onFilterChange);

    // QUAN LY POPUP

    function openModal(modal) {
        previousFocus = document.activeElement;
        submitting = false;

        modal.hidden = false;
        document.body.style.overflow = "hidden";

        const firstInput = modal.querySelector(
            'input:not([type="hidden"]), select, button'
        );

        if (firstInput) firstInput.focus();
    }

    function closeModal() {
        if (submitting) return;

        editModal.hidden = true;
        lockModal.hidden = true;

        document.body.style.overflow = "";

        if (previousFocus?.focus) {
            previousFocus.focus();
        }
    }

    document.querySelectorAll(".usm-close-modal")
        .forEach(button => {
            button.addEventListener("click", closeModal);
        });

    [editModal, lockModal].forEach(modal => {
        modal.addEventListener("click", event => {
            if (event.target === modal) closeModal();
        });
    });

    document.addEventListener("keydown", event => {
        if (event.key !== "Escape") return;

        if (!editModal.hidden || !lockModal.hidden) {
            closeModal();
        }
    });

    // POPUP SUA

    document.querySelectorAll(".usm-open-edit")
        .forEach(button => {
            button.addEventListener("click", () => {
                const row = getRow(button.dataset.id);
                if (!row) return;

                const d = row.dataset;

                editForm.action =
                    editBaseUrl.replace(/\/$/, "") + "/" +
                    encodeURIComponent(d.id);

                put("usmEditAvatar",
                    (d.name || "U").charAt(0).toUpperCase());

                put("usmEditProfileName", d.name);
                put("usmEditProfileId", "Mã tài khoản #" + d.id);
                put("usmEditStatus", d.statusText);
                put("usmEditCreated", d.created);

                byId("usmEditName").value = d.name || "";
                byId("usmEditEmail").value = d.email || "";
                byId("usmEditPhone").value = d.phone || "";
                byId("usmEditRole").value = d.role || "KhachHang";

                const isSelf = d.self === "true";

// Cấp lại mật khẩu chỉ dành cho tài khoản BTC.
const isOrganizer = d.role === "ToChuc";

byId("usmResetSection").hidden = !isOrganizer;
byId("usmResetUserId").value = isOrganizer ? d.id : "";

byId("usmResetPassword").value = "";
byId("usmResetConfirm").value = "";
byId("usmShowResetPassword").checked = false;

byId("usmResetPassword").type = "password";
byId("usmResetConfirm").type = "password";

byId("usmResetSubmit").disabled = false;

                byId("usmEditRole").disabled = isSelf;
                byId("usmSelfRoleNote").hidden = !isSelf;

                // Select disabled không gửi dữ liệu;
                // thêm input ẩn cho trường hợp tự sửa.
                const existingHidden =
                    byId("usmEditHiddenRole");

                if (existingHidden) existingHidden.remove();

                if (isSelf) {
                    const hidden = document.createElement("input");

                    hidden.type = "hidden";
                    hidden.id = "usmEditHiddenRole";
                    hidden.name = "VaiTro";
                    hidden.value = d.role;

                    editForm.appendChild(hidden);
                }

                byId("usmEditSubmit").disabled = false;
                openModal(editModal);

                byId("usmEditName").focus();
            });
        });

    // POPUP KHOA / MO KHOA

    document.querySelectorAll(".usm-open-lock")
        .forEach(button => {
            button.addEventListener("click", () => {
                const row = getRow(button.dataset.id);
                if (!row) return;

                const d = row.dataset;
                const unlock =
                    button.dataset.operation === "unlock";

                byId("usmLockId").value = d.id;

                put("usmLockAvatar",
                    (d.name || "U").charAt(0).toUpperCase());

                put("usmLockName", d.name);
                put("usmLockCode", "Mã tài khoản #" + d.id);
                put("usmLockEmail", d.email);
                put("usmLockPhone", d.phone || "Chưa cập nhật");
                put("usmLockRole", d.roleText);
                put("usmLockStatus", d.statusText);
                put("usmLockCreated", d.created);

                put("usmLockTitle", unlock
                    ? "Xác nhận mở khóa tài khoản"
                    : "Xác nhận khóa tài khoản");

                put("usmLockSubtitle", unlock
                    ? "Kiểm tra tài khoản trước khi khôi phục quyền truy cập."
                    : "Kiểm tra tài khoản trước khi vô hiệu hóa quyền truy cập.");

                put("usmLockMessage", unlock
                    ? "Sau khi mở khóa, người dùng có thể đăng nhập lại bằng tài khoản hiện tại."
                    : "Sau khi khóa, người dùng sẽ không thể đăng nhập hoặc tiếp tục sử dụng các chức năng yêu cầu xác thực.");

                const icon = byId("usmLockIcon");
                icon.className =
                    "usm-dialog-icon " + (unlock ? "unlock" : "lock");

                icon.innerHTML = unlock
                    ? '<i class="bi bi-unlock"></i>'
                    : '<i class="bi bi-lock"></i>';

                const note = byId("usmLockNote");
                note.className =
                    "usm-dialog-note" + (unlock ? " info" : "");

                const submit = byId("usmLockSubmit");

                submit.textContent = unlock
                    ? "Xác nhận mở khóa"
                    : "Xác nhận khóa";

                submit.className =
                    "usm-dialog-button confirm" +
                    (unlock ? " unlock" : "");

                submit.disabled = false;

                openModal(lockModal);
            });
        });

    // CHONG BAM GUI FORM LAP LAI

    [editForm, lockForm].forEach(form => {
        form.addEventListener("submit", event => {
            if (submitting) {
                event.preventDefault();
                return;
            }

            submitting = true;

            const submitButton = form.querySelector(
                'button[type="submit"]'
            );

            if (submitButton) {
                submitButton.disabled = true;
                submitButton.textContent = "Đang xử lý...";
            }
        });
    });

// HIEN / AN MAT KHAU TAM
byId("usmShowResetPassword").addEventListener(
    "change",
    function () {
        const type = this.checked ? "text" : "password";

        byId("usmResetPassword").type = type;
        byId("usmResetConfirm").type = type;
    }
);

// XAC NHAN CAP LAI MAT KHAU
byId("usmResetForm").addEventListener(
    "submit",
    function (event) {
        const password = byId("usmResetPassword").value;
        const confirmPassword = byId("usmResetConfirm").value;
        const userId = byId("usmResetUserId").value;

        if (!userId || byId("usmResetSection").hidden) {
            event.preventDefault();
            return;
        }

        if (
            password.length < 12 ||
            !/[A-Z]/.test(password) ||
            !/[a-z]/.test(password) ||
            !/[0-9]/.test(password) ||
            !/[^A-Za-z0-9]/.test(password)
        ) {
            event.preventDefault();

            alert(
                "Mật khẩu cần ít nhất 12 ký tự, gồm " +
                "chữ hoa, chữ thường, số và ký tự đặc biệt."
            );

            return;
        }

        if (password !== confirmPassword) {
            event.preventDefault();

            alert("Hai mật khẩu không khớp.");
            return;
        }

        const confirmed = window.confirm(
            "Bạn có chắc chắn muốn cấp lại mật khẩu " +
            "cho tài khoản Ban tổ chức này?"
        );

        if (!confirmed) {
            event.preventDefault();
            return;
        }

        byId("usmResetSubmit").disabled = true;
        byId("usmResetSubmit").textContent = "Đang xử lý...";
    }
);


    render();
})();
</script>

<!-- FORM CAP LAI MAT KHAU RIENG -->
<form id="usmResetForm"
      asp-controller="Admin"
      asp-action="CapLaiMatKhauBtc"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           id="usmResetUserId"
           name="id" />
</form>

