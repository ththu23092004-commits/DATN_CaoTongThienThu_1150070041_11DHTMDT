
@model IEnumerable<VeSuKienWeb.Models.Admin.YeuCauHoanHuyAdminVM>
@using System.Linq

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Theo dõi yêu cầu hủy vé";

    var danhSach = (Model ??
        Enumerable.Empty<VeSuKienWeb.Models.Admin.YeuCauHoanHuyAdminVM>())
        .OrderByDescending(x => x.NgayYeuCau)
        .ToList();

    int tong = danhSach.Count;
    int choXuLy = danhSach.Count(x => x.TrangThai == "ChoDuyet");
    int daHuy = danhSach.Count(x => x.TrangThai == "DaHuy");
    int tuChoi = danhSach.Count(x => x.TrangThai == "TuChoi");

    var danhSachBTC = danhSach
        .Where(x => !string.IsNullOrWhiteSpace(x.BanToChucId))
        .GroupBy(x => x.BanToChucId)
        .Select(g => new
        {
            Id = g.Key,
            Ten = g.First().TenBanToChuc
        })
        .OrderBy(x => x.Ten)
        .ToList();
}

<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet" />

<style>
    .acm-page,
    .acm-page *,
    .acm-modal,
    .acm-modal * {
        box-sizing: border-box;
        font-family: "Be Vietnam Pro", sans-serif;
    }

    .acm-page {
        width: 100%;
        min-width: 0;
        padding-bottom: 28px;
        color: #5b4867;
        font-size: 13px;
    }

    .acm-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #eaddec;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(85,48,104,.05);
    }

    .acm-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        padding: 21px;
        border-bottom: 1px solid #f0e7f2;
    }

    .acm-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        color: #513d5e;
        font-size: 18px;
        font-weight: 800;
    }

    .acm-title i {
        color: #a574ba;
        font-size: 20px;
    }

    .acm-description {
        margin: 7px 0 0;
        color: #9986a3;
        font-size: 12px;
        line-height: 1.8;
    }

    .acm-monitor {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 12px;
        border-radius: 9px;
        background: #f4ecf8;
        color: #9065a3;
        font-size: 11px;
        font-weight: 750;
    }

    /* THONG KE */

    .acm-stats {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 11px;
        padding: 17px 21px;
        border-bottom: 1px solid #f2eaf4;
    }

    .acm-stat {
        display: flex;
        align-items: center;
        gap: 11px;
        width: 100%;
        min-width: 0;
        min-height: 75px;
        padding: 12px;
        border: 1px solid #ede1f0;
        border-radius: 11px;
        background: #fcf9fd;
        text-align: left;
        color: inherit;
        cursor: pointer;
        transition: .18s;
    }

    .acm-stat:hover {
        background: #f9f2fb;
        transform: translateY(-2px);
        border-color: #d9bce3;
    }

    .acm-stat.active {
        background: #f8eefb;
        border-color: #b681c7;
        box-shadow: 0 0 0 3px rgba(174,118,191,.09);
    }

    .acm-stat-icon {
        display: grid;
        place-items: center;
        flex: 0 0 39px;
        width: 39px;
        height: 39px;
        border-radius: 11px;
        background: #f0e3f5;
        color: #9c6bb0;
        font-size: 18px;
    }

    .acm-stat-icon.pending {
        background: #fff3df;
        color: #b98a43;
    }

    .acm-stat-icon.done {
        background: #e6f6ee;
        color: #3a9571;
    }

    .acm-stat-icon.rejected {
        background: #fff0f4;
        color: #c4758d;
    }

    .acm-stat-label {
        display: block;
        color: #96829f;
        font-size: 11px;
    }

    .acm-stat-value {
        display: block;
        margin-top: 3px;
        color: #594565;
        font-size: 18px;
        font-weight: 800;
    }

    /* TIM KIEM VA LOC */

    .acm-toolbar {
        display: grid;
        grid-template-columns: minmax(220px,1fr) 230px 165px;
        gap: 10px;
        padding: 16px 21px;
    }

    .acm-search {
        position: relative;
        min-width: 0;
    }

    .acm-search > i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #aa91b7;
        pointer-events: none;
    }

    .acm-input,
    .acm-select {
        width: 100%;
        height: 42px;
        border: 1px solid #e6d9e9;
        border-radius: 9px;
        background: #fdfafd;
        color: #66516f;
        font-size: 12px;
        outline: none;
    }

    .acm-input {
        padding: 0 12px 0 38px;
    }

    .acm-select {
        padding: 0 10px;
        cursor: pointer;
    }

    .acm-input:focus,
    .acm-select:focus {
        border-color: #b98ac9;
        box-shadow: 0 0 0 3px rgba(174,118,191,.1);
    }

    .acm-filter-hint {
        padding: 0 21px 13px;
        color: #a08baa;
        font-size: 11px;
    }

    /* BANG */

    .acm-table-wrap {
        overflow-x: auto;
        width: 100%;
    }

    .acm-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

    .acm-table thead {
        background: #fcf8fd;
    }

    .acm-table th {
        padding: 14px 12px;
        color: #907b9c;
        font-size: 11.5px;
        font-weight: 800;
        text-align: left;
        white-space: nowrap;
        border-bottom: 1px solid #eee4f1;
    }

    .acm-table td {
        padding: 14px 12px;
        color: #705c79;
        font-size: 12px;
        line-height: 1.7;
        vertical-align: middle;
        border-bottom: 1px solid #f2eaf4;
    }

    .acm-row:hover {
        background: #fdf9fe;
    }

    .acm-primary {
        color: #55405f;
        font-size: 12px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .acm-secondary {
        color: #a18fa9;
        font-size: 10.5px;
        margin-top: 3px;
        overflow-wrap: anywhere;
    }

    .acm-ticket {
        font-weight: 800;
        color: #9464a9;
    }

    .acm-btc {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 145px;
    }

    .acm-btc-icon {
        display: grid;
        place-items: center;
        flex: 0 0 35px;
        width: 35px;
        height: 35px;
        border-radius: 10px;
        background: #f1e7f5;
        color: #9870aa;
        font-size: 16px;
    }

    .acm-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }

    .acm-badge.pending {
        color: #ad7d37;
        background: #fff3df;
    }

    .acm-badge.done {
        color: #2f8c6b;
        background: #e9f8f0;
    }

    .acm-badge.rejected {
        color: #ba7187;
        background: #fff0f4;
    }

    .acm-badge.other {
        color: #85738d;
        background: #f1edf4;
    }

    .acm-view {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 34px;
        padding: 7px 11px;
        border: 1px solid #e6d6eb;
        border-radius: 8px;
        background: #f9f0fb;
        color: #9464a8;
        font-size: 11.5px;
        font-weight: 750;
        cursor: pointer;
        white-space: nowrap;
    }

    .acm-view:hover {
        background: #f1e4f6;
    }

    .acm-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 15px 21px;
        border-top: 1px solid #f1e8f3;
    }

    .acm-count {
        font-size: 12px;
        color: #9884a1;
    }

    .acm-pagination {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .acm-page-button {
        min-width: 33px;
        height: 33px;
        padding: 0 10px;
        border: 1px solid #e9dbea;
        border-radius: 8px;
        background: white;
        color: #826c8c;
        font-size: 12px;
        cursor: pointer;
    }

    .acm-page-button.active {
        background: #ac76be;
        border-color: #ac76be;
        color: white;
    }

    .acm-page-button:disabled {
        opacity: .4;
        cursor: default;
    }

    .acm-empty {
        padding: 35px 20px;
        color: #a08da8;
        font-size: 12px;
        text-align: center;
    }

    .acm-empty[hidden],
    .acm-modal[hidden] {
        display: none !important;
    }

    /* POPUP CHI TIET */

    .acm-modal {
        position: fixed;
        inset: 0;
        z-index: 20000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(43,27,51,.55);
        backdrop-filter: blur(4px);
    }

    .acm-dialog {
        width: 100%;
        max-width: 620px;
        max-height: 90vh;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #eadbed;
        border-radius: 16px;
        box-shadow: 0 24px 70px rgba(36,19,44,.25);
    }

    .acm-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 21px 23px;
        border-bottom: 1px solid #f0e7f2;
        background: #fdfafe;
    }

    .acm-dialog-title {
        margin: 0;
        color: #523d60;
        font-size: 17px;
        font-weight: 800;
    }

    .acm-dialog-subtitle {
        margin: 6px 0 0;
        color: #9b89a5;
        font-size: 11.5px;
    }

    .acm-close {
        display: grid;
        place-items: center;
        flex: 0 0 34px;
        width: 34px;
        height: 34px;
        border: 1px solid #eee3f0;
        border-radius: 9px;
        background: #fff;
        color: #9a83a4;
        cursor: pointer;
    }

    .acm-dialog-body {
        padding: 22px 23px;
    }

    .acm-detail-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 11px;
        color: #735680;
        font-size: 12px;
        font-weight: 800;
    }

    .acm-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 20px;
    }

    .acm-detail {
        min-width: 0;
        padding: 12px;
        background: #fcf9fd;
        border: 1px solid #f0e5f2;
        border-radius: 9px;
    }

    .acm-detail-label {
        display: block;
        margin-bottom: 5px;
        color: #a28fac;
        font-size: 10.5px;
    }

    .acm-detail-value {
        display: block;
        color: #655071;
        font-size: 12px;
        font-weight: 750;
        line-height: 1.7;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .acm-reason {
        padding: 13px 14px;
        border: 1px solid #eee1f1;
        border-radius: 9px;
        background: #fdf9fe;
        color: #6a5576;
        font-size: 12px;
        line-height: 1.9;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .acm-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 17px;
        padding: 12px;
        background: #f3edf8;
        border-radius: 9px;
        color: #896b99;
        font-size: 11.5px;
        line-height: 1.8;
    }

    .acm-dialog-footer {
        display: flex;
        justify-content: flex-end;
        padding: 15px 23px 20px;
        border-top: 1px solid #f0e7f2;
    }

    .acm-done-button {
        min-height: 39px;
        padding: 9px 19px;
        border: 0;
        border-radius: 9px;
        background: #a673ba;
        color: #fff;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
    }

    @@media (max-width: 1080px) {
        .acm-stats {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .acm-toolbar {
            grid-template-columns: 1fr 1fr;
        }

        .acm-search {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 580px) {
        .acm-header,
        .acm-footer,
        .acm-dialog-header,
        .acm-dialog-body,
        .acm-dialog-footer {
            padding-left: 15px;
            padding-right: 15px;
        }

        .acm-stats {
            padding: 14px;
            gap: 8px;
        }

        .acm-toolbar {
            grid-template-columns: 1fr;
            padding: 14px;
        }

        .acm-search {
            grid-column: auto;
        }

        .acm-filter-hint {
            padding: 0 14px 12px;
        }

        .acm-detail-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="acm-page">

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-light border rounded-3 mb-3"
             role="status"
             style="color:#755b82;font-size:12px">
            <i class="bi bi-info-circle me-1"></i>
            @TempData["ThongBao"]
        </div>
    }

    <section class="acm-card">

        <div class="acm-header">
            <div>
                <h1 class="acm-title">
                    <i class="bi bi-ticket-perforated"></i>
                    Theo dõi yêu cầu hủy vé
                </h1>
                <p class="acm-description">
                    Theo dõi yêu cầu hủy vé theo Ban tổ chức,
                    sự kiện và trạng thái xử lý.
                </p>
            </div>

            <span class="acm-monitor">
                <i class="bi bi-eye"></i>
                Chế độ giám sát
            </span>
        </div>

        <!-- CAC O THONG KE -->
        <div class="acm-stats">

            <button type="button"
                    class="acm-stat active"
                    data-stat="all"
                    aria-pressed="true">
                <span class="acm-stat-icon">
                    <i class="bi bi-clipboard-data"></i>
                </span>
                <span>
                    <span class="acm-stat-label">
                        Tổng yêu cầu
                    </span>
                    <span class="acm-stat-value">@tong</span>
                </span>
            </button>

            <button type="button"
                    class="acm-stat"
                    data-stat="ChoDuyet"
                    aria-pressed="false">
                <span class="acm-stat-icon pending">
                    <i class="bi bi-hourglass-split"></i>
                </span>
                <span>
                    <span class="acm-stat-label">
                        Chờ xử lý
                    </span>
                    <span class="acm-stat-value">@choXuLy</span>
                </span>
            </button>

            <button type="button"
                    class="acm-stat"
                    data-stat="DaHuy"
                    aria-pressed="false">
                <span class="acm-stat-icon done">
                    <i class="bi bi-check-circle"></i>
                </span>
                <span>
                    <span class="acm-stat-label">
                        Đã hủy
                    </span>
                    <span class="acm-stat-value">@daHuy</span>
                </span>
            </button>

            <button type="button"
                    class="acm-stat"
                    data-stat="TuChoi"
                    aria-pressed="false">
                <span class="acm-stat-icon rejected">
                    <i class="bi bi-x-circle"></i>
                </span>
                <span>
                    <span class="acm-stat-label">
                        Từ chối
                    </span>
                    <span class="acm-stat-value">@tuChoi</span>
                </span>
            </button>
        </div>

        <!-- TIM KIEM VA LOC -->
        <div class="acm-toolbar">

            <div class="acm-search">
                <i class="bi bi-search"></i>
                <input type="search"
                       id="acmSearch"
                       class="acm-input"
                       autocomplete="off"
                       placeholder="Tìm mã vé, sự kiện, BTC, khách hàng..."
                       aria-label="Tìm yêu cầu hủy vé" />
            </div>

            <select id="acmBtc"
                    class="acm-select"
                    aria-label="Lọc theo Ban tổ chức">
                <option value="">Tất cả Ban tổ chức</option>

                @foreach (var btc in danhSachBTC)
                {
                    <option value="@btc.Id">
                        @btc.Ten
                    </option>
                }
            </select>

            <select id="acmStatus"
                    class="acm-select"
                    aria-label="Lọc trạng thái">
                <option value="">Tất cả trạng thái</option>
                <option value="ChoDuyet">Chờ xử lý</option>
                <option value="DaHuy">Đã hủy</option>
                <option value="TuChoi">Từ chối</option>
            </select>

        </div>

        <div class="acm-filter-hint">
            <i class="bi bi-info-circle me-1"></i>
            Ban tổ chức phụ trách duyệt hoặc từ chối.
            Admin chỉ xem thông tin, không xử lý yêu cầu.
        </div>

        <!-- BANG DANH SACH -->
        <div class="acm-table-wrap">
            <table class="acm-table">
                <thead>
                    <tr>
                        <th>Mã vé</th>
                        <th>Sự kiện</th>
                        <th>Ban tổ chức</th>
                        <th>Khách hàng</th>
                        <th>Số tiền vé</th>
                        <th>Ngày yêu cầu</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right">Chi tiết</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in danhSach)
                    {
                        string trangThaiText = item.TrangThai switch
                        {
                            "ChoDuyet" => "Chờ xử lý",
                            "DaHuy" => "Đã hủy",
                            "TuChoi" => "Từ chối",
                            _ => item.TrangThai
                        };

                        string trangThaiClass = item.TrangThai switch
                        {
                            "ChoDuyet" => "pending",
                            "DaHuy" => "done",
                            "TuChoi" => "rejected",
                            _ => "other"
                        };

                        <tr class="acm-row"
                            data-id="@item.YeuCauId"
                            data-ticket="@item.MaVe"
                            data-event="@item.TenSuKien"
                            data-btc-id="@item.BanToChucId"
                            data-btc="@item.TenBanToChuc"
                            data-customer="@item.TenNguoiDung"
                            data-email="@item.EmailNguoiDung"
                            data-money="@item.SoTien.ToString("N0") đ"
                            data-date="@item.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")"
                            data-status="@item.TrangThai"
                            data-status-text="@trangThaiText"
                            data-reason="@item.LyDo">

                            <td>
                                <span class="acm-ticket">
                                    @item.MaVe
                                </span>
                                <div class="acm-secondary">
                                    YC #@item.YeuCauId
                                </div>
                            </td>

                            <td style="max-width:210px">
                                <div class="acm-primary">
                                    @item.TenSuKien
                                </div>
                            </td>

                            <td>
                                <div class="acm-btc">
                                    <div class="acm-btc-icon">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>
                                    <div>
                                        <div class="acm-primary">
                                            @item.TenBanToChuc
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.BanToChucId))
                                        {
                                            <div class="acm-secondary">
                                                BTC #@item.BanToChucId
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td style="max-width:195px">
                                <div class="acm-primary">
                                    @item.TenNguoiDung
                                </div>
                                <div class="acm-secondary">
                                    @item.EmailNguoiDung
                                </div>
                            </td>

                            <td style="white-space:nowrap">
                                <span class="acm-primary">
                                    @item.SoTien.ToString("N0") đ
                                </span>
                            </td>

                            <td style="white-space:nowrap">
                                @item.NgayYeuCau.ToString("dd/MM/yyyy")
                                <div class="acm-secondary">
                                    @item.NgayYeuCau.ToString("HH:mm")
                                </div>
                            </td>

                            <td>
                                <span class="acm-badge @trangThaiClass">
                                    @if (item.TrangThai == "ChoDuyet")
                                    {
                                        <i class="bi bi-clock"></i>
                                    }
                                    else if (item.TrangThai == "DaHuy")
                                    {
                                        <i class="bi bi-check-circle"></i>
                                    }
                                    else if (item.TrangThai == "TuChoi")
                                    {
                                        <i class="bi bi-x-circle"></i>
                                    }

                                    @trangThaiText
                                </span>
                            </td>

                            <td style="text-align:right">
                                <button type="button"
                                        class="acm-view acm-open-detail"
                                        data-id="@item.YeuCauId">
                                    <i class="bi bi-eye"></i>
                                    Xem
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="acmEmpty"
             class="acm-empty"
             hidden>
            <i class="bi bi-inbox"
               style="display:block;font-size:29px;margin-bottom:9px"></i>
            Không có yêu cầu hủy vé phù hợp.
        </div>

        <div class="acm-footer">
            <span class="acm-count"
                  id="acmPageInfo"></span>

            <div id="acmPagination"
                 class="acm-pagination"></div>
        </div>

    </section>
</div>

<!-- POPUP XEM CHI TIET -->
<div class="acm-modal"
     id="acmModal"
     hidden>

    <div class="acm-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="acmModalTitle">

        <div class="acm-dialog-header">
            <div>
                <h2 class="acm-dialog-title"
                    id="acmModalTitle">
                    Chi tiết yêu cầu hủy vé
                </h2>

                <p class="acm-dialog-subtitle"
                   id="acmModalSubtitle"></p>
            </div>

            <button type="button"
                    class="acm-close"
                    id="acmCloseTop"
                    aria-label="Đóng cửa sổ">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="acm-dialog-body">

            <h3 class="acm-detail-heading">
                <i class="bi bi-calendar-event"></i>
                Thông tin sự kiện và Ban tổ chức
            </h3>

            <div class="acm-detail-grid">
                <div class="acm-detail">
                    <span class="acm-detail-label">Sự kiện</span>
                    <span class="acm-detail-value"
                          id="acmDetailEvent"></span>
                </div>

                <div class="acm-detail">
                    <span class="acm-detail-label">Ban tổ chức phụ trách</span>
                    <span class="acm-detail-value"
                          id="acmDetailBtc"></span>
                </div>
            </div>

            <h3 class="acm-detail-heading">
                <i class="bi bi-person"></i>
                Khách hàng và vé
            </h3>

            <div class="acm-detail-grid">
                <div class="acm-detail">
                    <span class="acm-detail-label">Khách hàng</span>
                    <span class="acm-detail-value"
                          id="acmDetailCustomer"></span>
                </div>

                <div class="acm-detail">
                    <span class="acm-detail-label">Email</span>
                    <span class="acm-detail-value"
                          id="acmDetailEmail"></span>
                </div>

                <div class="acm-detail">
                    <span class="acm-detail-label">Mã vé</span>
                    <span class="acm-detail-value"
                          id="acmDetailTicket"></span>
                </div>

                <div class="acm-detail">
                    <span class="acm-detail-label">Giá vé</span>
                    <span class="acm-detail-value"
                          id="acmDetailMoney"></span>
                </div>
            </div>

            <h3 class="acm-detail-heading">
                <i class="bi bi-clipboard-check"></i>
                Thông tin yêu cầu
            </h3>

            <div class="acm-detail-grid">
                <div class="acm-detail">
                    <span class="acm-detail-label">Ngày gửi yêu cầu</span>
                    <span class="acm-detail-value"
                          id="acmDetailDate"></span>
                </div>

                <div class="acm-detail">
                    <span class="acm-detail-label">Trạng thái xử lý</span>
                    <span class="acm-detail-value"
                          id="acmDetailStatus"></span>
                </div>
            </div>

            <h3 class="acm-detail-heading">
                <i class="bi bi-chat-left-text"></i>
                Lý do hủy vé
            </h3>

            <div class="acm-reason"
                 id="acmDetailReason"></div>

            <div class="acm-note">
                <i class="bi bi-shield-check"></i>
                <span>
                    Đây là thông tin giám sát dành cho Admin.
                    Việc chấp nhận, từ chối hủy vé và xử lý
                    hoàn tiền thuộc trách nhiệm Ban tổ chức.
                </span>
            </div>

        </div>

        <div class="acm-dialog-footer">
            <button type="button"
                    class="acm-done-button"
                    id="acmCloseBottom">
                Đóng
            </button>
        </div>

    </div>
</div>

<script>
(function () {
    "use strict";

    const rows = Array.from(
        document.querySelectorAll(".acm-row")
    );

    const stats = Array.from(
        document.querySelectorAll(".acm-stat")
    );

    const search = document.getElementById("acmSearch");
    const btc = document.getElementById("acmBtc");
    const status = document.getElementById("acmStatus");

    const empty = document.getElementById("acmEmpty");
    const info = document.getElementById("acmPageInfo");
    const pagination = document.getElementById("acmPagination");

    const modal = document.getElementById("acmModal");
    const closeTop = document.getElementById("acmCloseTop");
    const closeBottom = document.getElementById("acmCloseBottom");

    const pageSize = 8;

    let currentPage = 1;
    let selectedStat = "all";
    let previousFocus = null;

    function put(id, value) {
        document.getElementById(id).textContent =
            value || "Chưa cập nhật";
    }

    function normalize(text) {
        return String(text ?? "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/g, "d")
            .replace(/Đ/g, "D")
            .toLocaleLowerCase("vi-VN")
            .trim();
    }

    function filteredRows() {
        const keyword = normalize(search.value);

        return rows.filter(row => {
            const d = row.dataset;

            const content = normalize([
                d.ticket,
                d.event,
                d.btc,
                d.customer,
                d.email
            ].join(" "));

            return (
                (!keyword || content.includes(keyword)) &&
                (!btc.value || d.btcId === btc.value) &&
                (!status.value || d.status === status.value) &&
                (selectedStat === "all" ||
                    d.status === selectedStat)
            );
        });
    }

    function pageButton(label, page, active, disabled) {
        const button = document.createElement("button");

        button.type = "button";
        button.className =
            "acm-page-button" + (active ? " active" : "");

        button.textContent = label;
        button.disabled = disabled;

        if (active) {
            button.setAttribute("aria-current", "page");
        }

        button.addEventListener("click", () => {
            currentPage = page;
            render();
        });

        return button;
    }

    function render() {
        const matched = filteredRows();

        const pageCount = Math.max(
            1,
            Math.ceil(matched.length / pageSize)
        );

        currentPage = Math.min(currentPage, pageCount);

        rows.forEach(row => {
            row.hidden = true;
            row.style.display = "none";
        });

        const start = (currentPage - 1) * pageSize;
        const end = Math.min(start + pageSize, matched.length);

        matched.slice(start, end).forEach(row => {
            row.hidden = false;
            row.style.display = "";
        });

        empty.hidden = matched.length !== 0;

        info.textContent = matched.length
            ? `Hiển thị ${start + 1}–${end} / ${matched.length} yêu cầu`
            : "Không có yêu cầu phù hợp";

        pagination.replaceChildren();

        if (pageCount <= 1) return;

        pagination.appendChild(pageButton(
            "Trước",
            Math.max(1, currentPage - 1),
            false,
            currentPage === 1
        ));

        for (let i = 1; i <= pageCount; i++) {
            pagination.appendChild(pageButton(
                String(i), i, i === currentPage, false
            ));
        }

        pagination.appendChild(pageButton(
            "Sau",
            Math.min(pageCount, currentPage + 1),
            false,
            currentPage === pageCount
        ));
    }

    function refreshStat() {
        stats.forEach(button => {
            const active =
                button.dataset.stat === selectedStat;

            button.classList.toggle("active", active);
            button.setAttribute(
                "aria-pressed",
                active ? "true" : "false"
            );
        });
    }

    stats.forEach(button => {
        button.addEventListener("click", () => {
            selectedStat = button.dataset.stat;

            // Chọn thống kê mới thì bỏ lọc trạng thái cũ.
            status.value = "";

            currentPage = 1;
            refreshStat();
            render();
        });
    });

    search.addEventListener("input", () => {
        currentPage = 1;
        render();
    });

    btc.addEventListener("change", () => {
        currentPage = 1;
        render();
    });

    status.addEventListener("change", () => {
        selectedStat = "all";
        currentPage = 1;
        refreshStat();
        render();
    });

    function closeModal() {
        modal.hidden = true;
        document.body.style.overflow = "";

        if (previousFocus?.focus) {
            previousFocus.focus();
        }
    }

    document.querySelectorAll(".acm-open-detail")
        .forEach(button => {
            button.addEventListener("click", () => {
                const row = rows.find(
                    x => x.dataset.id === button.dataset.id
                );

                if (!row) return;

                const d = row.dataset;

                previousFocus = document.activeElement;

                put("acmModalSubtitle",
                    "Yêu cầu #" + d.id + " · " + d.ticket);

                put("acmDetailEvent", d.event);
                put("acmDetailBtc", d.btc);
                put("acmDetailCustomer", d.customer);
                put("acmDetailEmail", d.email);
                put("acmDetailTicket", d.ticket);
                put("acmDetailMoney", d.money);
                put("acmDetailDate", d.date);
                put("acmDetailStatus", d.statusText);
                put("acmDetailReason", d.reason);

                modal.hidden = false;
                document.body.style.overflow = "hidden";

                closeTop.focus();
            });
        });

    closeTop.addEventListener("click", closeModal);
    closeBottom.addEventListener("click", closeModal);

    modal.addEventListener("click", event => {
        if (event.target === modal) closeModal();
    });

    document.addEventListener("keydown", event => {
        if (modal.hidden) return;

        if (event.key === "Escape") {
            closeModal();
        }

        if (event.key === "Tab") {
            if (event.shiftKey &&
                document.activeElement === closeTop) {
                event.preventDefault();
                closeBottom.focus();
            }
            else if (!event.shiftKey &&
                     document.activeElement === closeBottom) {
                event.preventDefault();
                closeTop.focus();
            }
        }
    });

    render();
})();
</script>
