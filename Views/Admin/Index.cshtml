@model List<VeSuKienWeb.Models.SuKien>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyệt sự kiện";
}

<style>
    .admin-card {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
        overflow: hidden;
    }

    .admin-page-title {
        font-size: 30px;
        font-weight: 800;
        color: #111827;
    }

    .admin-table {
        width: 100%;
        table-layout: auto;
    }

    .admin-table th {
        font-size: 14px;
        color: #111827;
        font-weight: 700;
        white-space: nowrap;
        padding: 16px 10px;
        background: #f8fafc;
    }

    .admin-table td {
        padding: 14px 10px;
        vertical-align: middle;
        font-size: 13px;
        color: #374151;
    }

    .event-name {
        max-width: 210px;
    }

    .event-name .fw-bold {
        font-size: 14px;
        color: #111827;
    }

    .event-name .small {
        font-size: 12px;
        color: #6b7280;
    }

    .text-one-line {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .time-col {
        white-space: normal;
        min-width: 120px;
    }

    .type-col {
        min-width: 80px;
    }

    .org-col {
        max-width: 120px;
    }

    .status-col {
        white-space: nowrap;
        min-width: 90px;
    }

    .action-col {
        width: 170px;
        white-space: normal;
    }

    .badge-soft {
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .btn-action {
        border-radius: 999px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 5px;
        flex-wrap: wrap;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="admin-page-title mb-1">Duyệt sự kiện</h2>
        <div class="text-muted small">
            Admin xem danh sách sự kiện do các Ban tổ chức gửi lên và phê duyệt.
        </div>
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success rounded-4 border-0 shadow-sm">
        @TempData["ThongBao"]
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="admin-card">
        <table class="table table-hover align-middle mb-0 admin-table">
            <thead>
                <tr>
                    <th>Tên sự kiện</th>
                    <th class="time-col">Thời gian</th>
                    <th class="type-col">Loại</th>
                    <th class="org-col">Tổ chức</th>
                    <th class="status-col">Trạng thái</th>
                    <th class="action-col text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var sk in Model)
            {
                var thoiGian = $"{sk.ThoiGianBatDau:HH:mm dd/MM/yyyy} - {sk.ThoiGianKetThuc:HH:mm}";
                string trangThaiClass;
                string trangThaiText;

                switch (sk.TrangThaiDuyet)
                {
                    case "DaDuyet":
                        trangThaiClass = "bg-success";
                        trangThaiText = "Đã duyệt";
                        break;
                    case "TuChoi":
                        trangThaiClass = "bg-danger";
                        trangThaiText = "Từ chối";
                        break;
                    default:
                        trangThaiClass = "bg-warning text-dark";
                        trangThaiText = "Chờ duyệt";
                        break;
                }

                <tr>
                    <td>
                        <div class="event-name">
                            <div class="fw-bold text-one-line" title="@sk.TenSuKien">
                                @sk.TenSuKien
                            </div>
                            <div class="small text-muted text-one-line">
                                Đăng ngày @sk.NgayDang.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </td>

                    <td class="small time-col">@thoiGian</td>

                    <td class="small type-col">
                        <div class="text-one-line" title="@sk.LoaiSuKien?.TenLoai">
                            @sk.LoaiSuKien?.TenLoai
                        </div>
                    </td>

                    <td class="small org-col">
                        <div class="text-one-line" title="@sk.ToChucSuKien?.TenToChuc">
                            @sk.ToChucSuKien?.TenToChuc
                        </div>
                    </td>

                    <td class="status-col">
                        <span class="badge @trangThaiClass badge-soft">
                            @trangThaiText
                        </span>
                    </td>

                    <td class="action-col text-end">
                        <div class="action-buttons">
                            <a asp-action="ChiTiet"
                               asp-route-id="@sk.SuKienId"
                               class="btn btn-outline-primary btn-sm btn-action">
                                Chi tiết
                            </a>

                            @if (sk.TrangThaiDuyet == "ChoDuyet")
                            {
                                <form asp-action="Duyet" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@sk.SuKienId" />
                                    <button class="btn btn-success btn-sm btn-action" type="submit">
                                        Duyệt
                                    </button>
                                </form>

                                <form asp-action="TuChoi" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@sk.SuKienId" />
                                    <button class="btn btn-outline-danger btn-sm btn-action" type="submit">
                                        Từ chối
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Đã xử lý</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-light border rounded-4 shadow-sm">
        <div class="fw-semibold">Chưa có sự kiện nào.</div>
        <div class="small text-muted">Khi Ban tổ chức gửi sự kiện, bạn sẽ thấy tại đây để duyệt.</div>
    </div>
}