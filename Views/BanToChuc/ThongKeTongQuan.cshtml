
@model VeSuKienWeb.Models.BanToChuc.ThongKeTongQuanDashboardVM
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_LayoutBanToChuc.cshtml";
    ViewData["Title"] = "Thống kê tổng quan";

    var jsonOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    var months = Model.HoatDongTheoThang.Select(x => new {
        name = x.Thang,
        sold = x.VeThanhToan,
        checkin = x.LuotCheckIn
    }).ToList();

    var eventStates = Model.TrangThaiSuKien.Select(x => new {
        name = x.TrangThai,
        value = x.SoLuong
    }).ToList();

    string TicketName(string? s) => s switch {
        "DaThanhToan" => "Đã thanh toán",
        "DaCheckIn" => "Đã check-in",
        "Huy" => "Đã hủy",
        "DaHuy" => "Đã hủy",
        "ChuaThanhToan" => "Chưa thanh toán",
        _ => s ?? "Khác"
    };

    string RequestName(string? s) => s switch {
        "ChoDuyet" => "Chờ duyệt",
        "DaHuy" => "Đã chấp nhận",
        "TuChoi" => "Từ chối",
        _ => s ?? "Khác"
    };

    var ticketStates = Model.TrangThaiVe.Select(x => new {
        name = TicketName(x.TrangThai),
        value = x.SoLuong
    }).ToList();

    var requestStates = Model.TrangThaiHoanHuy.Select(x => new {
        name = RequestName(x.TrangThai),
        value = x.SoLuong
    }).ToList();

    var filterName = Model.SuKienDangChon.HasValue
        ? Model.DanhSachSuKien
            .FirstOrDefault(x => x.SuKienId == Model.SuKienDangChon.Value)
            ?.TenSuKien ?? "Sự kiện"
        : "Tất cả sự kiện";
}

<style>
    .dbx, .dbx * {
        box-sizing: border-box;
        font-family: "Be Vietnam Pro", sans-serif;
    }
    .dbx {
        color: #52415c;
        font-size: 12px;
        padding-bottom: 30px;
        min-width: 0;
    }
    .dbx-header, .dbx-heading, .dbx-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .dbx-header {
        align-items: flex-start;
        flex-wrap: wrap;
        margin-bottom: 19px;
    }
    .dbx-eyebrow {
        color: #a875ba;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: .6px;
        margin-bottom: 5px;
    }
    .dbx-title {
        color: #46344f;
        font-size: 21px;
        font-weight: 800;
        margin: 0;
    }
    .dbx-subtitle {
        color: #97879e;
        font-size: 12px;
        line-height: 1.7;
        margin: 7px 0 0;
    }
    .dbx-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }
    .dbx-select, .dbx-button {
        min-height: 38px;
        padding: 8px 12px;
        border: 1px solid #e8dbea;
        background: #fff;
        color: #765f81;
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        border-radius: 9px;
    }
    .dbx-select {
        max-width: 230px;
        outline: none;
    }
    .dbx-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        text-decoration: none;
    }
    .dbx-button:hover {
        background: #faf2fc;
        color: #a667b4;
    }
    .dbx-section { margin-bottom: 20px; }
    .dbx-heading {
        flex-wrap: wrap;
        margin-bottom: 11px;
    }
    .dbx-heading h2 {
        font-size: 14px;
        font-weight: 800;
        color: #4b3855;
        margin: 0;
    }
    .dbx-heading h2 span {
        font-size: 11px;
        margin-right: 8px;
        color: #a675b8;
    }
    .dbx-muted {
        font-size: 11px;
        color: #9d8ba5;
    }
    .dbx-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 11px;
    }
    .dbx-kpi {
        min-width: 0;
        background: #fff;
        border: 1px solid #eddfed;
        border-top: 3px solid var(--accent);
        border-radius: 13px;
        padding: 15px;
        box-shadow: 0 4px 16px rgba(86,54,103,.04);
    }
    .dbx-purple { --accent:#9b79d0; --soft:#f2ecfc; }
    .dbx-teal { --accent:#45b4a1; --soft:#e9f8f5; }
    .dbx-orange { --accent:#edaa61; --soft:#fff4e7; }
    .dbx-pink { --accent:#df86aa; --soft:#fff0f6; }
    .dbx-kpi-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }
    .dbx-kpi-label {
        color: #8e7c98;
        font-size: 11px;
        font-weight: 650;
    }
    .dbx-kpi-icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 9px;
        color: var(--accent);
        background: var(--soft);
        font-size: 16px;
    }
    .dbx-kpi-value {
        color: #493651;
        font-size: 23px;
        font-weight: 800;
        margin: 9px 0 4px;
        font-variant-numeric: tabular-nums;
    }
    .dbx-kpi-note {
        color: #a090a7;
        font-size: 10.5px;
        line-height: 1.7;
    }
    .dbx-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
    }
    .dbx-panel {
        min-width: 0;
        overflow: hidden;
        background: white;
        border: 1px solid #eddfed;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(86,54,103,.04);
    }
    .dbx-panel-head {
        align-items: flex-start;
        padding: 15px 16px 12px;
        border-bottom: 1px solid #f3eaf3;
    }
    .dbx-panel-head h3 {
        font-size: 13px;
        font-weight: 750;
        margin: 0;
        color: #533e5e;
    }
    .dbx-panel-head p {
        font-size: 11px;
        line-height: 1.65;
        color: #9b8ca3;
        margin: 5px 0 0;
    }
    .dbx-tag {
        flex-shrink: 0;
        padding: 6px 9px;
        background: #f7eef9;
        color: #a36fb1;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 700;
    }
    .dbx-chart {
        height: 235px;
        position: relative;
        padding: 12px 14px 10px;
    }
    .dbx-chart canvas {
        width: 100% !important;
        height: 100% !important;
    }
    .dbx-chart-foot {
        padding: 0 16px 13px;
        font-size: 10.5px;
        color: #9888a0;
        line-height: 1.7;
    }
    .dbx-items { padding: 5px 16px 9px; }
    .dbx-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #f2eaf3;
    }
    .dbx-item:last-child { border-bottom: 0; }
    .dbx-item-main { min-width: 0; }
    .dbx-item-title {
        font-size: 12px;
        line-height: 1.6;
        font-weight: 750;
        color: #574260;
        text-decoration: none;
    }
    a.dbx-item-title:hover { color: #a46db7; }
    .dbx-item-sub {
        font-size: 10.5px;
        color: #9b8ba2;
        margin-top: 5px;
        line-height: 1.7;
    }
    .dbx-item-number {
        color: #8d65ad;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }
    .dbx-status {
        padding: 6px 9px;
        background: #f6eef9;
        color: #8b6e98;
        font-size: 10px;
        font-weight: 700;
        border-radius: 7px;
        white-space: nowrap;
    }
    .dbx-status.pending {
        color: #a66d2c;
        background: #fff3e6;
    }
    .dbx-status.approved {
        color: #248769;
        background: #e8f7f1;
    }
    .dbx-status.rejected {
        color: #ba5578;
        background: #fff0f5;
    }
    .dbx-link {
        color: #9f68b0;
        font-size: 11px;
        font-weight: 750;
        text-decoration: none;
        white-space: nowrap;
    }
    .dbx-link:hover { text-decoration: underline; }
    .dbx-empty {
        padding: 27px 15px;
        text-align: center;
        color: #9c8ca4;
        font-size: 12px;
    }
    .dbx-note {
        margin-top: 12px;
        font-size: 11px;
        color: #9888a0;
        line-height: 1.8;
    }
    @@media(max-width:1150px) {
        .dbx-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media(max-width:900px) {
        .dbx-grid { grid-template-columns: 1fr; }
    }
    @@media(max-width:600px) {
        .dbx-header { flex-direction: column; }
        .dbx-kpi { padding: 12px; }
        .dbx-kpi-value { font-size: 20px; }
        .dbx-chart { height: 225px; }
        .dbx-actions, .dbx-actions form, .dbx-select { width: 100%; max-width: none; }
    }
</style>

<div class="dbx">
    <header class="dbx-header">
        <div>
            <div class="dbx-eyebrow">
                BAN TỔ CHỨC / OPERATIONS
            </div>
            <h1 class="dbx-title">Thống kê tổng quan</h1>
            <p class="dbx-subtitle">
                Theo dõi vận hành sự kiện, tình hình vé,
                check-in và yêu cầu cần xử lý.
            </p>
        </div>
        <div class="dbx-actions">
            <form asp-controller="BanToChuc"
                  asp-action="ThongKeTongQuan" method="get">
                <select name="suKienId" class="dbx-select"
                        aria-label="Lọc theo sự kiện"
                        onchange="this.form.submit()">
                    <option value="">Tất cả sự kiện</option>
                    @foreach (var s in Model.DanhSachSuKien)
                    {
                        <option value="@s.SuKienId"
                                selected="@(Model.SuKienDangChon == s.SuKienId)">
                            @s.TenSuKien
                        </option>
                    }
                </select>
            </form>
            <button type="button" class="dbx-button"
                    onclick="location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Làm mới
            </button>
        </div>
    </header>

    <section class="dbx-section">
        <div class="dbx-heading">
            <h2><span>01</span> Tổng quan hoạt động</h2>
            <span class="dbx-muted">@filterName · Toàn bộ lịch sử</span>
        </div>
        <div class="dbx-kpis">
            <div class="dbx-kpi dbx-purple">
                <div class="dbx-kpi-head">
                    <span class="dbx-kpi-label">Tổng sự kiện</span>
                    <span class="dbx-kpi-icon">
                        <i class="bi bi-calendar-event"></i>
                    </span>
                </div>
                <div class="dbx-kpi-value">@Model.TongSuKien.ToString("N0")</div>
                <div class="dbx-kpi-note">Thuộc Ban tổ chức đăng nhập</div>
            </div>
            <div class="dbx-kpi dbx-teal">
                <div class="dbx-kpi-head">
                    <span class="dbx-kpi-label">Vé còn hiệu lực</span>
                    <span class="dbx-kpi-icon">
                        <i class="bi bi-ticket-perforated"></i>
                    </span>
                </div>
                <div class="dbx-kpi-value">@Model.TongVeDaBan.ToString("N0")</div>
                <div class="dbx-kpi-note">Đã thanh toán hoặc đã check-in</div>
            </div>
            <div class="dbx-kpi dbx-orange">
                <div class="dbx-kpi-head">
                    <span class="dbx-kpi-label">Vé đã check-in</span>
                    <span class="dbx-kpi-icon">
                        <i class="bi bi-qr-code-scan"></i>
                    </span>
                </div>
                <div class="dbx-kpi-value">@Model.TongCheckIn.ToString("N0")</div>
                <div class="dbx-kpi-note">Ghi nhận vào cổng thành công</div>
            </div>
            <div class="dbx-kpi dbx-pink">
                <div class="dbx-kpi-head">
                    <span class="dbx-kpi-label">Yêu cầu chờ duyệt</span>
                    <span class="dbx-kpi-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </span>
                </div>
                <div class="dbx-kpi-value">@Model.YeuCauChoDuyet.ToString("N0")</div>
                <div class="dbx-kpi-note">Cần xử lý yêu cầu hủy vé</div>
            </div>
        </div>
    </section>

    <section class="dbx-section">
        <div class="dbx-heading">
            <h2><span>02</span> Phân tích vận hành</h2>
            <span class="dbx-muted">4 biểu đồ · Di chuột để xem số liệu</span>
        </div>

        <div class="dbx-grid">
            <article class="dbx-panel">
                <div class="dbx-panel-head">
                    <div>
                        <h3>Vé thanh toán và check-in</h3>
                        <p>Xu hướng theo tháng trong 12 tháng gần nhất.</p>
                    </div>
                    <span class="dbx-tag">Đường</span>
                </div>
                <div class="dbx-chart">
                    <canvas id="opsTicketsTrend"></canvas>
                </div>
                <div class="dbx-chart-foot">
                    Tím: vé phát sinh thanh toán · Xanh: lượt check-in.
                </div>
            </article>

            <article class="dbx-panel">
                <div class="dbx-panel-head">
                    <div>
                        <h3>Trạng thái sự kiện</h3>
                        <p>Phân loại theo tiến độ tổ chức và phê duyệt.</p>
                    </div>
                    <span class="dbx-tag">Cột</span>
                </div>
                <div class="dbx-chart">
                    <canvas id="opsEventStatus"></canvas>
                </div>
                <div class="dbx-chart-foot">
                    Nhận biết nhanh số sự kiện cần chuẩn bị hoặc phê duyệt.
                </div>
            </article>

            <article class="dbx-panel">
                <div class="dbx-panel-head">
                    <div>
                        <h3>Trạng thái vé hiện tại</h3>
                        <p>So sánh vé đã thanh toán, check-in và đã hủy.</p>
                    </div>
                    <span class="dbx-tag">Cột ngang</span>
                </div>
                <div class="dbx-chart">
                    <canvas id="opsTicketStatus"></canvas>
                </div>
                <div class="dbx-chart-foot">
                    Mỗi vé chỉ thuộc một trạng thái hiện tại.
                </div>
            </article>

            <article class="dbx-panel">
                <div class="dbx-panel-head">
                    <div>
                        <h3>Trạng thái yêu cầu hủy</h3>
                        <p>Khối lượng yêu cầu chờ duyệt và đã xử lý.</p>
                    </div>
                    <span class="dbx-tag">Cột ngang</span>
                </div>
                <div class="dbx-chart">
                    <canvas id="opsCancelStatus"></canvas>
                </div>
                <div class="dbx-chart-foot">
                    Phân tích trạng thái yêu cầu, không phải số tiền hoàn.
                </div>
            </article>
        </div>
    </section>

    <section class="dbx-section">
        <div class="dbx-heading">
            <h2><span>03</span> Theo dõi và xử lý</h2>
            <span class="dbx-muted">Liên kết đến nghiệp vụ thực tế</span>
        </div>
        <div class="dbx-grid">
            <article class="dbx-panel">
                <div class="dbx-panel-head">
                    <div>
                        <h3>Sự kiện sắp diễn ra</h3>
                        <p>5 sự kiện gần nhất trong 30 ngày tới.</p>
                    </div>
                    <a asp-controller="BanToChuc" asp-action="Index"
                       class="dbx-link">Xem tất cả</a>
                </div>
                @if (Model.SuKienSapDienRa.Any())
                {
                    <div class="dbx-items">
                        @foreach (var s in Model.SuKienSapDienRa)
                        {
                            <div class="dbx-item">
                                <div class="dbx-item-main">
                                    <a class="dbx-item-title"
                                       asp-controller="BanToChuc"
                                       asp-action="ChiTiet"
                                       asp-route-id="@s.SuKienId">
                                        @s.TenSuKien
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                    <div class="dbx-item-sub">
                                        @s.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                                <span class="dbx-item-number">@s.SoVeHieuLuc vé</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="dbx-empty">
                        Chưa có sự kiện sắp diễn ra trong 30 ngày tới.
                    </div>
                }
            </article>

            <article class="dbx-panel">
                <div class="dbx-panel-head">
                    <div>
                        <h3>Yêu cầu hủy gần đây</h3>
                        <p>5 yêu cầu mới nhất của Ban tổ chức.</p>
                    </div>
                    <a asp-controller="BanToChuc"
                       asp-action="YeuCauHuyVe"
                       class="dbx-link">Xử lý yêu cầu</a>
                </div>
                @if (Model.YeuCauGanDay.Any())
                {
                    <div class="dbx-items">
                        @foreach (var y in Model.YeuCauGanDay)
                        {
                            var statusClass = y.TrangThai switch {
                                "ChoDuyet" => "pending",
                                "DaHuy" => "approved",
                                "TuChoi" => "rejected",
                                _ => ""
                            };
                            <div class="dbx-item">
                                <div class="dbx-item-main">
                                    <div class="dbx-item-title">@y.TenSuKien</div>
                                    <div class="dbx-item-sub">
                                        @y.MaVe ·
                                        @y.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                                <span class="dbx-status @statusClass">
                                    @RequestName(y.TrangThai)
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="dbx-empty">Chưa có yêu cầu hủy vé.</div>
                }
            </article>
        </div>

        <div class="dbx-note">
            <i class="bi bi-info-circle"></i>
            KPI phản ánh trạng thái hiện tại của dữ liệu.
            Biểu đồ đường ghi nhận vé theo ngày thanh toán và
            check-in theo ngày vào cổng. Tải lại trang để cập nhật SQL Server.
        </div>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function () {
    "use strict";

    const months = @Html.Raw(JsonSerializer.Serialize(months, jsonOptions));
    const events = @Html.Raw(JsonSerializer.Serialize(eventStates, jsonOptions));
    const tickets = @Html.Raw(JsonSerializer.Serialize(ticketStates, jsonOptions));
    const requests = @Html.Raw(JsonSerializer.Serialize(requestStates, jsonOptions));

    if (typeof Chart === "undefined") {
        console.error("Chart.js chưa được tải.");
        return;
    }

    const colors = {
        purple: "#9b79d0",
        teal: "#45b4a1",
        orange: "#edaa61",
        pink: "#df86aa",
        blue: "#79a6db",
        gray: "#b3a7bd"
    };

    const palette = [
        colors.purple, colors.teal, colors.orange,
        colors.pink, colors.blue, colors.gray
    ];

    Chart.defaults.font.family = "'Be Vietnam Pro', sans-serif";
    Chart.defaults.font.size = 11;
    Chart.defaults.color = "#8c7c96";

    const baseOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: "#493653",
                titleFont: { size: 12 },
                bodyFont: { size: 11 },
                padding: 11,
                cornerRadius: 9
            }
        }
    };

    const count = value => new Intl.NumberFormat("vi-VN").format(value);

    function barChart(canvasId, items, horizontal) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;

        new Chart(canvas, {
            type: "bar",
            data: {
                labels: items.map(x => x.name),
                datasets: [{
                    label: "Số lượng",
                    data: items.map(x => x.value),
                    backgroundColor: items.map(
                        (_, i) => palette[i % palette.length]
                    ),
                    borderRadius: 6,
                    maxBarThickness: 33
                }]
            },
            options: {
                ...baseOptions,
                indexAxis: horizontal ? "y" : "x",
                plugins: {
                    ...baseOptions.plugins,
                    tooltip: {
                        ...baseOptions.plugins.tooltip,
                        callbacks: {
                            label: ctx => "Số lượng: " + count(ctx.raw)
                        }
                    }
                },
                scales: horizontal ? {
                    x: {
                        beginAtZero: true,
                        grid: { color: "#f1eaf3" },
                        ticks: { precision: 0 }
                    },
                    y: {
                        grid: { display: false }
                    }
                } : {
                    x: {
                        grid: { display: false },
                        ticks: {
                            maxRotation: 30,
                            autoSkip: false
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: "#f1eaf3" },
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    }

    new Chart(document.getElementById("opsTicketsTrend"), {
        type: "line",
        data: {
            labels: months.map(x => x.name),
            datasets: [
                {
                    label: "Vé thanh toán",
                    data: months.map(x => x.sold),
                    borderColor: colors.purple,
                    backgroundColor: "rgba(155,121,208,.11)",
                    tension: .32,
                    borderWidth: 2.5,
                    pointRadius: 2.5,
                    pointHoverRadius: 5,
                    fill: true
                },
                {
                    label: "Lượt check-in",
                    data: months.map(x => x.checkin),
                    borderColor: colors.teal,
                    backgroundColor: colors.teal,
                    tension: .32,
                    borderWidth: 2.5,
                    pointRadius: 2.5,
                    pointHoverRadius: 5,
                    fill: false
                }
            ]
        },
        options: {
            ...baseOptions,
            interaction: { mode: "index", intersect: false },
            plugins: {
                ...baseOptions.plugins,
                legend: {
                    position: "bottom",
                    labels: {
                        usePointStyle: true,
                        boxWidth: 7,
                        padding: 12
                    }
                },
                tooltip: {
                    ...baseOptions.plugins.tooltip,
                    callbacks: {
                        label: ctx => ctx.dataset.label + ": " +
                            count(ctx.raw) + " vé"
                    }
                }
            },
            scales: {
                x: { grid: { display: false } },
                y: {
                    beginAtZero: true,
                    grid: { color: "#f1eaf3" },
                    ticks: { precision: 0 }
                }
            }
        }
    });

    barChart("opsEventStatus", events, false);
    barChart("opsTicketStatus", tickets, true);
    barChart("opsCancelStatus", requests, true);

})();
</script>
