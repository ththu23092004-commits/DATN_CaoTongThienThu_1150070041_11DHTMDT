                    <option value="bottom">Phía sau hội trường</option>
                </select>
            </div>

            <div class="sd-actions">
                <button type="button" id="sdRestore"
                        class="btn btn-outline-secondary">
                    Khôi phục toàn bộ ghế
                </button>
            </div>
        </aside>

        <section class="sd-preview">
<div class="sd-toolbar">
