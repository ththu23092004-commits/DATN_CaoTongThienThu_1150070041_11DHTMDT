                    <option value="small">Hội trường nhỏ - 60 ghế</option>
                    <option value="medium">Hội trường vừa - 240 ghế</option>
                    <option value="large">Phòng lớn - 1000 ghế</option>
                    <option value="workshop">Phòng họp - 32 ghế</option>
                </select>
            </div>

            <div class="sd-group">
                <div class="sd-group-title">02. Bố trí ghế</div>

