                </div>

                <label for="sdVipRows">Số hàng VIP tính từ sân khấu</label>
                <input id="sdVipRows" class="form-control"
                       type="number" min="0" max="20" value="2" />
            </div>

            <div class="sd-group">
                <div class="sd-group-title">03. Lối đi và cửa</div>

                <div class="sd-switch-row">
                    <label for="sdVerticalAisle">Lối đi giữa các dãy</label>
                    <input id="sdVerticalAisle" type="checkbox" checked />
                </div>

                <div class="sd-switch-row">
                    <label for="sdHorizontalAisle">Lối đi ngang</label>
                    <input id="sdHorizontalAisle" type="checkbox" checked />
                </div>

