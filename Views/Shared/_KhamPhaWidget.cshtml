
<link rel="stylesheet"
      href="~/css/kham-pha-widget.css"
      asp-append-version="true" />

<div id="kpWidget" class="kp-widget">

    <button type="button"
            id="kpLauncher"
            class="kp-launcher"
            aria-label="Mở khám phá sự kiện"
            aria-controls="kpPanel"
            aria-expanded="false">
        <span class="kp-launcher-icon">✦</span>
        <span class="kp-launcher-label">Khám phá sự kiện</span>
        <span class="kp-launcher-dot"></span>
    </button>

    <section id="kpPanel"
             class="kp-panel"
             role="dialog"
             aria-label="Khám phá sự kiện"
             aria-modal="false"
             hidden>

        <div class="kp-header">

            <div class="kp-header-avatar">✦</div>

            <div class="kp-header-info">
                <div class="kp-header-title">
                    Khám phá sự kiện
                </div>

                <div class="kp-header-subtitle">
                    <span class="kp-status-dot"></span>
                    Tìm sự kiện theo cách của bạn
                </div>
            </div>

            @if (User?.Identity?.IsAuthenticated == true &&
                 User.IsInRole("KhachHang"))
            {
                <button type="button"
                        id="kpHistoryToggle"
                        class="kp-history-toggle"
                        aria-label="Lịch sử trò chuyện"
                        aria-controls="kpHistoryPanel"
                        aria-expanded="false"
                        title="Lịch sử trò chuyện">
                    <svg width="19"
                         height="19"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                        <path d="M3 3v5h5" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                </button>
            }

            <button type="button"
                    id="kpClose"
                    class="kp-header-close"
                    aria-label="Đóng trò chuyện">
                &times;
            </button>

        </div>

        @if (User?.Identity?.IsAuthenticated == true &&
             User.IsInRole("KhachHang"))
        {
            <section id="kpHistoryPanel"
                     class="kp-history-panel"
                     aria-label="Lịch sử trò chuyện"
                     hidden>

                <div class="kp-history-header">

                    <div class="kp-history-heading">
                        <div class="kp-history-title">
                            Lịch sử trò chuyện
                        </div>
                        <div class="kp-history-subtitle">
                            Xem lại những lần khám phá trước đây
                        </div>
                    </div>

                    <button type="button"
                            id="kpHistoryNew"
                            class="kp-history-new">
                        <span>＋</span>
                        Cuộc trò chuyện mới
                    </button>

                </div>

                <div id="kpHistoryLoading"
                     class="kp-history-loading"
                     hidden>
                    <span class="kp-history-spinner"></span>
                    Đang tải lịch sử...
                </div>

                <div id="kpHistoryError"
                     class="kp-history-error"
                     role="alert"
                     hidden>
                </div>

                <div id="kpHistoryEmpty"
                     class="kp-history-empty"
                     hidden>
                    <div class="kp-history-empty-icon">◷</div>

                    <div class="kp-history-empty-title">
                        Chưa có cuộc trò chuyện nào
                    </div>

                    <p>
                        Những lần bạn khám phá sự kiện
                        sẽ được lưu tại đây.
                    </p>
                </div>

                <div id="kpHistoryList"
                     class="kp-history-list"
                     role="list"
                     aria-label="Danh sách cuộc trò chuyện">
                </div>

                <div class="kp-history-footer">
                    <span>✦</span>
                    Lịch sử chỉ hiển thị với tài khoản của bạn
                </div>

            </section>
        }

        <div class="kp-body"
             id="kpMessages"
             role="log"
             aria-live="polite"
             aria-relevant="additions">

            <div class="kp-date-divider">
                Khám phá cùng chúng mình
            </div>

            <div class="kp-message kp-message-bot">
                <div class="kp-bot-avatar">✦</div>

                <div class="kp-bubble">
                    <div class="kp-bubble-title">
                        Xin chào! 👋
                    </div>

                    <p>
                        Bạn muốn tham gia sự kiện như thế nào?
                        Hãy mô tả chủ đề, địa điểm, thời gian
                        hoặc ngân sách nhé.
                    </p>

                    <p>
                        Mình sẽ tìm tối đa
                        <strong>3 sự kiện phù hợp nhất</strong>
                        từ hệ thống.
                    </p>
                </div>
            </div>

            <div class="kp-suggestions"
                 id="kpSuggestions">

                <button type="button"
                        class="kp-chip"
                        data-kp-question="Tìm sự kiện âm nhạc ở TP.HCM">
                    🎵 Âm nhạc tại TP.HCM
                </button>

                <button type="button"
                        class="kp-chip"
                        data-kp-question="Tìm sự kiện sân khấu sắp diễn ra">
                    🎭 Sân khấu
                </button>

                <button type="button"
                        class="kp-chip"
                        data-kp-question="Tìm workshop về công nghệ và AI">
                    ✨ Công nghệ &amp; AI
                </button>

            </div>

        </div>

        <div class="kp-bottom" id="kpBottom">

            <div class="kp-bottom-tools">

                <span>
                    Gợi ý dựa trên dữ liệu sự kiện
                </span>

                <button type="button"
                        id="kpReset"
                        class="kp-reset"
                        title="Bắt đầu cuộc trò chuyện mới">
                    ↻ Cuộc trò chuyện mới
                </button>

            </div>

            <form id="kpForm"
                  class="kp-form"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="kpHoiThoaiId"
                       name="hoiThoaiId"
                       value="" />

                <label for="kpInput"
                       class="kp-visually-hidden">
                    Nội dung tìm kiếm sự kiện
                </label>

                <textarea id="kpInput"
                          name="noiDung"
                          maxlength="500"
                          rows="1"
                          placeholder="Bạn muốn tìm sự kiện gì?"
                          autocomplete="off"
                          required></textarea>

                <button type="submit"
                        id="kpSend"
                        class="kp-send"
                        aria-label="Gửi câu hỏi">

                    <svg width="19"
                         height="19"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.4"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M12 19V5"></path>
                        <path d="m5 12 7-7 7 7"></path>
                    </svg>

                </button>

            </form>

            <div class="kp-note">
                Thông tin giá và vé có thể thay đổi.
            </div>

        </div>

    </section>

</div>

<script src="~/js/kham-pha-widget.js"
        asp-append-version="true"
        defer></script>

<script>
    document.addEventListener("pointerdown", function (event) {
        const widget = document.getElementById("kpWidget");
        const panel = document.getElementById("kpPanel");
        const launcher = document.getElementById("kpLauncher");
        const closeButton = document.getElementById("kpClose");

        if (!widget || !panel || !launcher || !closeButton) {
            return;
        }

        if (panel.hidden) {
            return;
        }

        if (panel.contains(event.target)) {
            return;
        }

        if (launcher.contains(event.target)) {
            return;
        }

        closeButton.click();
    });
</script>
