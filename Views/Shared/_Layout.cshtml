
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Hệ thống sự kiện</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="~/css/site.css"
          asp-append-version="true"
          rel="stylesheet" />

    <link href="~/css/event-redesign.css"
          asp-append-version="true"
          rel="stylesheet" />

    <style>
        /* ============================================
           HEADER BAN TO CHUC
           DONG BO PHONG CACH KHACH HANG
           ============================================ */

        .btc-theme-header,
        .btc-theme-header * {
            box-sizing: border-box;
            font-family: "Be Vietnam Pro", sans-serif;
        }

        .btc-theme-header {
            position: relative;
            z-index: 100;
        }

        .btc-theme-header .btc-main-nav {
            min-height: 74px;
            padding: 11px 0;
            background: #f6eafd !important;
            border-bottom: 1px solid #ead7f3;
            box-shadow: 0 4px 17px rgba(103, 65, 124, .055);
        }

        .btc-theme-header .btc-main-nav > .container {
            max-width: 1180px;
            display: flex;
            align-items: center;
            gap: 23px;
        }

        /* LOGO */

        .btc-theme-header .event-brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            padding: 0;
            margin-right: 22px;
            text-decoration: none;
        }

        .btc-theme-header .event-brand-symbol {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 39px;
            height: 39px;
            border-radius: 12px;
            background: linear-gradient(
                135deg,
                #b663c4 0%,
                #d175bc 100%
            );
            color: #ffffff;
            box-shadow: 0 5px 13px rgba(172, 88, 179, .17);
            transition: transform .2s ease;
        }

        .btc-theme-header .event-brand-symbol i {
            font-size: 19px;
            line-height: 1;
            color: #ffffff;
        }

        .btc-theme-header .event-brand:hover .event-brand-symbol {
            transform: translateY(-2px);
        }

        /* DIEU HUONG */

        .btc-theme-header .navbar-collapse {
            align-items: center;
        }

        .btc-theme-header .navbar-nav {
            align-items: center;
            gap: 8px;
        }

        .btc-theme-header .navbar-nav .nav-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 9px 11px;
            border-radius: 9px;
            color: #674c79 !important;
            font-size: 12px;
            font-weight: 500;
            line-height: 1.5;
            white-space: nowrap;
            text-decoration: none;
            transition:
                color .2s ease,
                background .2s ease;
        }

        .btc-theme-header .navbar-nav .nav-link i {
            color: #8d699d;
            font-size: 14px;
            transition: color .2s ease;
        }

        .btc-theme-header .navbar-nav .nav-link:hover {
            background: rgba(187, 124, 202, .10);
            color: #8849a1 !important;
        }

        .btc-theme-header .navbar-nav .nav-link:hover i {
            color: #8849a1;
        }

        .btc-theme-header .navbar-nav .nav-link.active {
            background: rgba(187, 124, 202, .13);
            color: #81469b !important;
            font-weight: 600;
        }

        .btc-theme-header .navbar-nav .nav-link.active i {
            color: #81469b;
        }

        /* TAI KHOAN BEN PHAI */

        .btc-theme-header .navbar-text {
            color: #846c92 !important;
            font-size: 11.5px;
            font-weight: 400;
            white-space: nowrap;
        }

        /* NUT DANG XUAT */

        .btc-theme-header .event-auth-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            min-height: 38px;
            padding: 9px 15px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(
                110deg,
                #ae62be 0%,
                #cc70b7 100%
            );
            color: #ffffff !important;
            font-size: 11.5px;
            font-weight: 700;
            line-height: 1.4;
            white-space: nowrap;
            text-decoration: none;
            box-shadow: 0 5px 12px rgba(177, 98, 188, .12);
            transition:
                background .2s ease,
                transform .2s ease,
                box-shadow .2s ease;
        }

        .btc-theme-header .event-auth-button i {
            color: #ffffff;
            font-size: 13px;
        }

        .btc-theme-header .event-auth-button:hover {
            background: linear-gradient(
                110deg,
                #9a50ad 0%,
                #ba5eaa 100%
            );
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 7px 16px rgba(177, 98, 188, .19);
        }

        .btc-theme-header .event-auth-button:focus-visible,
        .btc-theme-header .nav-link:focus-visible,
        .btc-theme-header .event-brand:focus-visible {
            outline: 2px solid #a866bb;
            outline-offset: 3px;
        }

        /* NUT MENU MOBILE */

        .btc-theme-header .navbar-toggler {
            border: 1px solid #d9bce5;
            border-radius: 9px;
            padding: 7px 10px;
            box-shadow: none;
        }

        .btc-theme-header .navbar-toggler:focus {
            box-shadow: 0 0 0 3px rgba(177, 114, 194, .14);
        }

        /* NEN KHU VUC BAN TO CHUC */

        body.btc-theme-page {
            background: linear-gradient(
                135deg,
                #faf6fc 0%,
                #f6effa 52%,
                #faf5fb 100%
            ) !important;
        }

        /* RESPONSIVE */

        @@media (max-width: 1199px) {
            .btc-theme-header .btc-main-nav > .container {
                gap: 10px;
            }

            .btc-theme-header .event-brand {
                margin-right: 10px;
            }

            .btc-theme-header .navbar-nav {
                gap: 3px;
            }

            .btc-theme-header .navbar-nav .nav-link {
                padding: 8px;
                font-size: 11.5px;
            }

            .btc-theme-header .navbar-text {
                font-size: 11px;
            }
        }

        @@media (max-width: 991px) {
            .btc-theme-header .btc-main-nav {
                min-height: 67px;
                padding: 12px 0;
            }

            .btc-theme-header .btc-main-nav > .container {
                flex-wrap: wrap;
            }

            .btc-theme-header .navbar-collapse {
                flex-basis: 100%;
                padding-top: 14px;
            }

            .btc-theme-header .navbar-nav {
                align-items: stretch;
                gap: 4px;
            }

            .btc-theme-header .navbar-nav .nav-link {
                width: 100%;
                padding: 11px 12px;
                font-size: 12px;
            }

            .btc-theme-header .navbar-text {
                display: block;
                padding: 10px 12px;
                white-space: normal;
            }

            .btc-theme-header .navbar-nav form {
                padding: 5px 0;
            }

            .btc-theme-header .event-auth-button {
                width: 100%;
                min-height: 40px;
            }
        }

/* An nut tai khoan cu, chi giu cua so popup */
#khAccountRoot {
    display: none !important;
}

.kh-greeting-button {
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    padding: 9px 11px;
    cursor: pointer;
    color: #765184 !important;
    font-family: "Be Vietnam Pro", sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    transition: all .2s ease;
}

.kh-greeting-button:hover,
.kh-greeting-button[aria-expanded="true"] {
    background: #f0e1f6;
    border-color: #e6d2ee;
    color: #945eaa !important;
}

.kh-greeting-menu {
    min-width: 225px;
    padding: 8px;
    border: 1px solid #ead9ee;
    border-radius: 12px;
    box-shadow: 0 14px 35px rgba(72, 42, 88, .13);
}

.kh-greeting-menu .dropdown-item {
    display: flex;
    align-items: center;
    padding: 11px 12px;
    border-radius: 8px;
    color: #745b81;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
}

.kh-greeting-menu .dropdown-item:hover {
    background: #f6edfa;
    color: #915ba8;
}

.kh-greeting-menu .dropdown-item i {
    color: #a478b4;
    font-size: 15px;
}

    </style>
</head>

@{
    var controller =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var action =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool laAdmin = User?.IsInRole("Admin") ?? false;

    bool laBTC =
        (User?.IsInRole("ToChuc") ?? false) ||
        (User?.IsInRole("BanToChuc") ?? false);

    bool laKhachHang =
        User?.IsInRole("KhachHang") ?? false;

    bool laTrangQuanLy =
        controller == "Admin" ||
        controller == "BanToChuc" ||
        controller == "KiemThuGoiY" ||
        controller == "KhamPhaSuKien";

    bool giaoDienMoi =
        !laAdmin &&
        !laBTC &&
        !laTrangQuanLy;

bool giaoDienBTC =
    !laAdmin &&
    (laBTC ||
     controller.Equals(
         "BanToChuc",
         StringComparison.OrdinalIgnoreCase));

    bool hienWidget =
        giaoDienMoi &&
        (controller == "Home" ||
         controller == "SuKien" ||
         controller == "KhachHang");


    string lopBody = giaoDienMoi
        ? "event-redesign"
        : (giaoDienBTC || laAdmin)
            ? "btc-theme-page"
            : "bg-light";

    string lopHeader = (giaoDienBTC || laAdmin)
        ? "event-header btc-theme-header"
        : "event-header";

    string lopNavbar = giaoDienMoi
        ? "navbar-dark event-main-nav"
        : (giaoDienBTC || laAdmin)
            ? "navbar-light btc-main-nav"
            : "navbar-light bg-white shadow-sm";
}


<body class="d-flex flex-column min-vh-100 @lopBody">

    <header class="@lopHeader">

        <nav class="navbar navbar-expand-lg @lopNavbar">

            <div class="container">

                <!-- LOGO -->

<a class="navbar-brand event-brand"
   asp-controller="@(laAdmin ? "Admin" : giaoDienBTC ? "BanToChuc" : "Home")"
   asp-action="Index"
   aria-label="@(laAdmin ? "Về Dashboard Admin" : giaoDienBTC ? "Quản lý sự kiện" : "Về trang chủ")">

                    <span class="event-brand-symbol">
                        <i class="bi bi-ticket-perforated"></i>
                    </span>

                    <span class="event-brand-text"></span>

                </a>

                <!-- MOBILE MENU -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Mở menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNav">

                    <!-- MENU BEN TRAI -->

<!-- MENU BEN TRAI -->

@if (!giaoDienBTC && !laAdmin)
{
    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <!-- TRANG CHU -->
        <li class="nav-item">
            <a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")"
               asp-controller="Home"
               asp-action="Index">
                <i class="bi bi-house-door me-1"></i>
                Trang chủ
            </a>
        </li>

        <!-- SU KIEN -->
        <li class="nav-item">
            @if (laKhachHang)
            {
                <a class="nav-link @(controller == "KhachHang" && action == "Index" ? "active" : "")"
                   asp-controller="KhachHang"
                   asp-action="Index">
                    <i class="bi bi-calendar-event me-1"></i>
                    Sự kiện
                </a>
            }
            else
            {
                <a class="nav-link @(controller == "SuKien" ? "active" : "")"
                   asp-controller="SuKien"
                   asp-action="DanhSach">
                    <i class="bi bi-calendar-event me-1"></i>
                    Sự kiện
                </a>
            }
        </li>

        <!-- VE CUA TOI - KHACH HANG -->
        @if (laKhachHang)
        {
            <li class="nav-item">
                <a class="nav-link @(controller == "KhachHang" && action == "VeCuaToi" ? "active" : "")"
                   asp-controller="KhachHang"
                   asp-action="VeCuaToi">
                    <i class="bi bi-ticket-perforated me-1"></i>
                    Vé của tôi
                </a>
            </li>
        }

        <!-- QUAN LY HE THONG - ADMIN -->
        @if (laAdmin)
        {
            <li class="nav-item">
                <a class="nav-link @(controller == "Admin" ? "active" : "")"
                   asp-controller="Admin"
                   asp-action="Index">
                    <i class="bi bi-gear me-1"></i>
                    Quản lý hệ thống
                </a>
            </li>
        }

    </ul>
}
else
{
    <!-- BTC KHONG CO MENU HEADER -->
    <div class="me-auto"></div>
}


                    <!-- TAI KHOAN BEN PHAI -->

                    <ul class="navbar-nav ms-auto align-items-lg-center">

@* Chuông chỉ hiển thị cho khách hàng đã đăng nhập *@
@if (laKhachHang &&
     (User?.Identity?.IsAuthenticated ?? false))
{
    <li class="nav-item d-flex align-items-lg-center">
        <partial name="_ChuongThongBaoKhachHang" />
    </li>
}

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {

<li class="nav-item">


@if (laKhachHang)
{
    <button type="button"
            class="navbar-text me-lg-3 kh-greeting-button"
            onclick="window.openKhAccount?.('profile')"
            aria-label="Mở thông tin tài khoản">

        Xin chào,
        @(User?.Identity?.Name ?? "Khách hàng")

        <i class="bi bi-person-circle ms-1"></i>
    </button>
}
else
{
    <span class="navbar-text me-lg-3">
        Xin chào,
        @(User?.Identity?.Name ?? "Người dùng")
    </span>
}


</li>


                            <li class="nav-item">

                                <form asp-controller="TaiKhoan"
                                      asp-action="DangXuat"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn event-auth-button">

                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Đăng xuất

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="btn event-auth-button"
                                   asp-controller="TaiKhoan"
                                   asp-action="DangNhap">

                                    <i class="bi bi-person-circle me-1"></i>
                                    Đăng nhập

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- NOI DUNG TRANG -->

    <main class="flex-fill event-main">

        <div class="@(laTrangQuanLy ? "container-fluid px-2 px-lg-3" : "container")">

            @RenderBody()

        </div>

    </main>

    <!-- BOOTSTRAP -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

    <!-- HERO SLIDER - GIU NGUYEN -->

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const hero = document.querySelector(
                '.hero-banner.hero-slider'
            );

            if (!hero) return;

            const images = [
                '/images/hero-event-1.jpg',
                '/images/hero-event-2.jpg',
                '/images/hero-event-3.jpg'
            ];

            let index = 0;

            function showSlide() {
                hero.classList.remove('hero-zoom');
                void hero.offsetWidth;

                hero.style.backgroundImage =
                    "url('" + images[index] + "')";

                hero.classList.add('hero-zoom');

                index = (index + 1) % images.length;
            }

            showSlide();

            setInterval(showSlide, 7000);
        });
    </script>

 
<!-- WIDGET KHAM PHA SU KIEN -->

@if (hienWidget)
{
    <partial name="_KhamPhaWidget" />
}

<!-- CUA SO THONG TIN TAI KHOAN KHACH HANG -->
@if (laKhachHang &&
     (User?.Identity?.IsAuthenticated ?? false))
{
    <partial name="_MenuTaiKhoanKhachHang" />
}

</body>
</html>
