@using Microsoft.AspNetCore.Mvc.Rendering
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper<dynamic> HtmlHelper

@{
    Layout = "_Layout";

    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<style>
    
/* =========================================
   MỞ RỘNG GIAO DIỆN BAN TỔ CHỨC
   ========================================= */

/* Bỏ giới hạn chiều rộng container của layout cha,
   chỉ áp dụng khi trang chứa giao diện BTC. */
body:has(.btc-shell) > .container,
body:has(.btc-shell) > .container-fluid,
body:has(.btc-shell) main > .container,
body:has(.btc-shell) main > .container-fluid {
    width: 100% !important;
    max-width: 100% !important;
    padding-left: 12px !important;
    padding-right: 12px !important;
}

/* Mở rộng phần nội dung BTC */
.btc-shell {
    width: 100%;
    max-width: none;
    margin: 0;
}

.btc-layout {
    width: 100%;
    max-width: none;
}

.btc-content {
    min-width: 0;
    width: 100%;
}


.btc-shell {
    background: #f5f7fb;
    min-height: calc(100vh - 56px);
    width: 100%;
    max-width: none;
    padding: 20px 8px 30px;
}



.btc-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    width: 100%;
    max-width: none;
}


    .btc-sidebar {
        position: sticky;
        top: 76px;
        min-height: calc(100vh - 100px);
        background: #ffffff;
        border: 1px solid #e6ebf3;
        border-radius: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
        padding: 22px;
        display: flex;
        flex-direction: column;
    }

    .btc-brand {
        margin-bottom: 24px;
    }

    .btc-brand-title {
        color: #0f172a;
        font-size: 23px;
        font-weight: 900;
        line-height: 1.2;
        margin-bottom: 8px;
    }

    .btc-brand-subtitle {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .btc-nav {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btc-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #334155;
        padding: 12px 13px;
        border-radius: 15px;
        font-size: 14.5px;
        font-weight: 650;
        transition: .2s ease;
    }

    .btc-nav-link i {
        width: 20px;
        text-align: center;
        font-size: 16px;
        color: #64748b;
        transition: .2s ease;
    }

    .btc-nav-link:hover {
        background: #f1f5f9;
        color: #1d4ed8;
        transform: translateX(2px);
    }

    .btc-nav-link:hover i {
        color: #1d4ed8;
    }

    .btc-nav-link.active {
        background: #eef2ff;
        color: #2563eb;
        font-weight: 800;
        box-shadow: inset 3px 0 0 #2563eb;
    }

    .btc-nav-link.active i {
        color: #2563eb;
    }

    .btc-footer {
        margin-top: auto;
        padding-top: 18px;
        border-top: 1px solid #edf2f7;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.6;
    }

    .btc-content {
        min-width: 0;
        width: 100%;
        background: transparent;
    }

    @@media (max-width: 992px) {
        .btc-shell {
            padding: 16px;
        }

        .btc-layout {
            grid-template-columns: 1fr;
        }

        .btc-sidebar {
            position: relative;
            top: 0;
            min-height: auto;
        }

        .btc-nav {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .btc-nav {
            grid-template-columns: 1fr;
        }

        .btc-sidebar {
            padding: 20px;
            border-radius: 22px;
        }
    }
</style>

<div class="btc-shell">
    <div class="btc-layout">
        <aside class="btc-sidebar">
            <div class="btc-brand">
                <div class="btc-brand-title">Ban tổ chức</div>
                <p class="btc-brand-subtitle">Quản lý sự kiện và vé</p>
            </div>

            <nav class="btc-nav">
                <a asp-controller="BanToChuc"
                   asp-action="Index"
                   class="btc-nav-link @(currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-calendar-event"></i>
                    <span>Sự kiện của tôi</span>
                </a>

                <a asp-controller="BanToChuc"
                   asp-action="TaoSuKien"
                   class="btc-nav-link @(currentAction == "TaoSuKien" ? "active" : "")">
                    <i class="bi bi-plus-circle"></i>
                    <span>Tạo sự kiện mới</span>
                </a>



<a asp-controller="BanToChuc"
   asp-action="YeuCauHuyVe"
   class="btc-nav-link @(currentAction == "YeuCauHuyVe" ? "active" : "")">
    <i class="bi bi-arrow-repeat"></i>
    <span>Yêu cầu hoàn/hủy vé</span>
</a>



                <a asp-controller="BanToChuc"
                   asp-action="ThongKeTongQuan"
                   class="btc-nav-link @(currentAction == "ThongKeTongQuan" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i>
                    <span>Thống kê tổng quan</span>
                </a>


<a asp-controller="BanToChuc"
   asp-action="DoanhThuTheoSuKien"
   class="btc-nav-link @(currentAction == "DoanhThuTheoSuKien" ? "active" : "")">
    <i class="bi bi-bar-chart-line"></i>
    <span>Doanh thu theo sự kiện</span>
</a>


            </nav>

            <div class="btc-footer">
                <div>© 2026</div>
                <div>Đặt Vé Sự Kiện</div>
            </div>
        </aside>

        <main class="btc-content">
            @RenderBody()
        </main>
    </div>
</div>

@RenderSection("Scripts", required: false)