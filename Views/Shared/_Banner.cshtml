@model List<VeSuKienWeb.Models.SuKien>

@{
    var data = Model ?? new List<VeSuKienWeb.Models.SuKien>();
    var now = DateTime.Now;

    var suKienNoiBat = data
        .Where(x => x.TrangThaiDuyet == "DaDuyet" && x.ThoiGianKetThuc > now)
        .OrderBy(x => x.ThoiGianBatDau)
        .Take(4)
        .ToList();

    var suKienSapDienRa = data
        .Where(x => x.TrangThaiDuyet == "DaDuyet" && x.ThoiGianBatDau > now)
        .OrderBy(x => x.ThoiGianBatDau)
        .Take(8)
        .ToList();
}

<style>
