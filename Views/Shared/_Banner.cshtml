<div class="home-page-pro">

    <section class="home-hero">
        <div class="home-hero-inner">
            <div>
                <h1 class="home-hero-title">Khám phá sự kiện dành cho bạn</h1>

                <p class="home-hero-desc">
                    Tìm kiếm các sự kiện nổi bật, đặt vé nhanh chóng và check-in tiện lợi bằng mã QR.
                </p>

                <form method="get" action="/KhachHang/Index" class="home-search">
                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="search"
                           placeholder="Tìm kiếm sự kiện, ca sĩ, địa điểm..." />

                    <button type="submit">Tìm kiếm</button>
                </form>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="section-head">
            <div class="section-label">Nổi bật</div>
            <h2 class="section-title">Sự kiện nổi bật</h2>
            <div class="section-sub">Những chương trình đang được quan tâm</div>
        </div>

        @if (suKienNoiBat.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
                @foreach (var sk in suKienNoiBat)
                {
                    var img = Url.Content(string.IsNullOrWhiteSpace(sk.AnhSuKien)
                        ? "~/images/default-event.jpg"
                        : sk.AnhSuKien);

                    <div class="col">
                        <a asp-controller="KhachHang"
                           asp-action="ChiTiet"
                           asp-route-id="@sk.SuKienId"
                           class="event-link">

                            <div class="event-card">
                                <div class="event-image">
                                    <img src="@img" alt="@sk.TenSuKien" />

                                    <div class="date-badge">
                                        <strong>@sk.ThoiGianBatDau.ToString("dd")</strong>
                                        <span>TH @sk.ThoiGianBatDau.ToString("MM")</span>
                                    </div>

                                    <div class="event-status">Còn mở</div>
                                </div>

                                <div class="event-body">
                                    <span class="event-type">
                                        @(sk.LoaiSuKien != null ? sk.LoaiSuKien.TenLoai : "Sự kiện")
                                    </span>

                                    <div class="event-name">@sk.TenSuKien</div>

                                    <div class="event-time">
    <i class="bi bi-clock"></i>
    @sk.ThoiGianBatDau.ToString("HH:mm dd/MM/yyyy")
</div>

@if (sk.ToChucSuKien != null)
@if (sk.DiaDiem != null)
{
    <div class="event-location">
        <i class="bi bi-geo-alt"></i>
        @(string.IsNullOrWhiteSpace(sk.DiaDiem.TenDiaDiem)
            ? sk.DiaDiem.DiaChi
            : sk.DiaDiem.TenDiaDiem)
    </div>
}

                                    <div class="event-bottom">
                                        <div class="event-price">
                                            @(sk.GiaVeMacDinh.HasValue && sk.GiaVeMacDinh.Value > 0
                                                ? "Từ " + sk.GiaVeMacDinh.Value.ToString("N0") + " đ"
                                                : "Miễn phí")
                                        </div>

                                        <div class="event-view">Chi tiết</div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-box">Hiện chưa có sự kiện nổi bật.</div>
        }
    </section>

    <section class="home-section">
        <div class="section-head">
            <div class="section-label">Sắp diễn ra</div>
            <h2 class="section-title">Sự kiện sắp diễn ra</h2>
            <div class="section-sub">Các sự kiện mới nhất đang mở đặt vé</div>
        </div>

        @if (suKienSapDienRa.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
                @foreach (var sk in suKienSapDienRa)
                {
                    var img = Url.Content(string.IsNullOrWhiteSpace(sk.AnhSuKien)
                        ? "~/images/default-event.jpg"
                        : sk.AnhSuKien);

                    <div class="col">
                        <a asp-controller="KhachHang"
                           asp-action="ChiTiet"
                           asp-route-id="@sk.SuKienId"
                           class="event-link">

                            <div class="event-card">
                                <div class="event-image">
                                    <img src="@img" alt="@sk.TenSuKien" />

                                    <div class="date-badge">
                                        <strong>@sk.ThoiGianBatDau.ToString("dd")</strong>
                                        <span>TH @sk.ThoiGianBatDau.ToString("MM")</span>
                                    </div>

                                    <div class="event-status">Sắp diễn ra</div>
                                </div>

                                <div class="event-body">
                                    <span class="event-type">
                                        @(sk.LoaiSuKien != null ? sk.LoaiSuKien.TenLoai : "Sự kiện")
                                    </span>

                                 <div class="event-name">@sk.TenSuKien</div>

<div class="event-time">
    <i class="bi bi-clock"></i>
    @sk.ThoiGianBatDau.ToString("HH:mm dd/MM/yyyy")
</div>

@if (sk.DiaDiem != null)
{
    <div class="event-location">
        <i class="bi bi-geo-alt"></i>
        @(string.IsNullOrWhiteSpace(sk.DiaDiem.TenDiaDiem)
            ? sk.DiaDiem.DiaChi
            : sk.DiaDiem.TenDiaDiem)
    </div>
}

                                    <div class="event-bottom">
                                        <div class="event-price">
                                            @(sk.GiaVeMacDinh.HasValue && sk.GiaVeMacDinh.Value > 0
                                                ? "Từ " + sk.GiaVeMacDinh.Value.ToString("N0") + " đ"
                                                : "Miễn phí")
                                        </div>

                                        <div class="event-view">Chi tiết</div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-box">Hiện chưa có sự kiện sắp diễn ra.</div>
        }
    </section>
<div class="info-heading">
    <span class="info-heading-badge">
        <i class="bi bi-stars"></i>
        Trải nghiệm nổi bật
    </span>

    <h2>
        Không chỉ là đặt vé,<br />
        mà còn là hành trình khám phá sự kiện
    </h2>

  
</div>
<section class="info-showcase">

    <div class="info-row">

        <div class="info-image">
            <img src="@Url.Content("~/images/showcase/concert.jpg")">
        </div>

        <div class="info-content">

            <span class="info-tag">
                Âm nhạc & Liveshow
            </span>

            <h3>
                Những đêm nhạc đáng mong chờ nhất
            </h3>

            <p>
                Khám phá các liveshow, đại nhạc hội và chương trình biểu diễn nghệ thuật được tổ chức trên toàn quốc.
                Người tham gia có thể theo dõi lịch diễn, lựa chọn vị trí phù hợp và đặt vé trực tuyến nhanh chóng.
            </p>

            <a href="/KhachHang/Index" class="info-btn">
                Khám phá sự kiện
            </a>

        </div>

    </div>


    <div class="info-row reverse">

        <div class="info-content">

            <span class="info-tag">
                Workshop & Hội thảo
            </span>

            <h3>
                Học hỏi, kết nối và phát triển kỹ năng
            </h3>

            <p>
                Từ workshop kỹ năng mềm đến các hội thảo chuyên ngành,
                hệ thống giúp người tham gia dễ dàng tìm kiếm chương trình phù hợp và đăng ký chỉ với vài thao tác đơn giản.
            </p>

            <a href="/KhachHang/Index" class="info-btn">
                Xem chương trình
            </a>

        </div>

        <div class="info-image">
            <img src="@Url.Content("~/images/showcase/workshop.jpg")">
        </div>

    </div>


    <div class="info-row">

        <div class="info-image">
            <img src="@Url.Content("~/images/showcase/online-event.jpg")">
        </div>

        <div class="info-content">

            <span class="info-tag">
                Sự kiện trực tuyến
            </span>

            <h3>
                Tham gia ở bất kỳ đâu
            </h3>

            <p>
                Các sự kiện trực tuyến được tổ chức thông qua nền tảng họp trực tuyến,
                cho phép người tham gia dễ dàng kết nối từ mọi nơi mà không cần di chuyển.
            </p>

            <a href="/KhachHang/Index" class="info-btn">
                Tìm hiểu thêm
            </a>

        </div>

    </div>

</section>

    <footer class="home-footer">
        <div class="row g-4 align-items-start">
            <div class="col-lg-5">
                <div class="footer-brand">Đặt Vé Sự Kiện</div>
                <p class="footer-text">
                    Nền tảng tìm kiếm, đặt vé và quản lý vé tham gia sự kiện trực tuyến với giao diện hiện đại, rõ ràng và dễ sử dụng.
                </p>
            </div>

            <div class="col-lg-3">
                <div class="footer-title">Điều hướng</div>
                <a class="footer-link" href="/">Trang chủ</a>
                <a class="footer-link" href="/KhachHang/Index">Sự kiện</a>
                <a class="footer-link" href="/TaiKhoan/DangNhap">Đăng nhập</a>
            </div>

            <div class="col-lg-4">
                <div class="footer-title">Hỗ trợ khách hàng</div>
                <p class="footer-info">
                    Email: eventticket@gmail.com<br />
                    Hotline: 0909 163 821<br />
                    Thời gian hỗ trợ: 08:00 đến 22:00
                </p>
            </div>
        </div>
    </footer>

</div>