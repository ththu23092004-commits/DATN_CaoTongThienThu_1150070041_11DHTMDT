
@model object

@{
    ViewData["Title"] = "Kiểm thử khám phá sự kiện";

    var ketQua = ViewBag.KetQua
        as VeSuKienWeb.Models.KhamPhaSuKien.NhuCauKhamPha;
}

<div class="container py-5"
     style="max-width:950px;">

    <div class="mb-4">
        <span class="badge bg-primary mb-2">
            KIỂM THỬ NỘI BỘ
        </span>

        <h2 class="fw-bold">
            Khám phá sự kiện thông minh
        </h2>

        <p class="text-muted">
            Kiểm tra khả năng phân tích nhu cầu
            tìm sự kiện bằng Gemini AI.
        </p>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <form asp-controller="KhamPhaSuKien"
                  asp-action="KiemThu"
                  method="post">

                @Html.AntiForgeryToken()

                <label class="form-label fw-semibold">
                    Nhập nhu cầu tìm sự kiện
                </label>

                <textarea name="noiDung"
                          class="form-control"
                          rows="3"
                          maxlength="500"
                          required
                          placeholder="Ví dụ: Tôi muốn tìm sự kiện âm nhạc ở TP.HCM dưới 300k">@ViewBag.NoiDung</textarea>

                <button type="submit"
                        class="btn btn-primary mt-3 px-4">
                    <i class="bi bi-stars"></i>
                    Phân tích nhu cầu
                </button>
            </form>
        </div>
    </div>

    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Loi
        </div>
    }

    @if (ketQua != null)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <strong>
                    <i class="bi bi-check-circle"></i>
                    Gemini đã phân tích nhu cầu
                </strong>
            </div>

            <div class="card-body p-4">
                <table class="table table-bordered align-middle">
                    <tbody>
                        <tr>
                            <th style="width:35%">Chủ đề</th>
                            <td>@(ketQua.ChuDe ?? "Không xác định")</td>
                        </tr>

                        <tr>
                            <th>Địa điểm</th>
                            <td>@(ketQua.DiaDiem ?? "Không giới hạn")</td>
                        </tr>

                        <tr>
                            <th>Ngân sách tối đa</th>
                            <td>
                                @(ketQua.NganSachToiDa.HasValue
                                    ? ketQua.NganSachToiDa.Value.ToString("N0") + " đ"
                                    : "Không giới hạn")
                            </td>
                        </tr>

                        <tr>
                            <th>Từ ngày</th>
                            <td>@(ketQua.TuNgay ?? "Không giới hạn")</td>
                        </tr>

                        <tr>
                            <th>Đến ngày</th>
                            <td>@(ketQua.DenNgay ?? "Không giới hạn")</td>
                        </tr>

                        <tr>
                            <th>Hình thức</th>
                            <td>@(ketQua.HinhThuc ?? "Không giới hạn")</td>
                        </tr>

                        <tr>
                            <th>Từ khóa bổ sung</th>
                            <td>@(ketQua.TuKhoa ?? "Không có")</td>
                        </tr>

                        <tr>
                            <th>Câu hỏi bổ sung</th>
                            <td>@(ketQua.CauHoiBoSung ?? "Không cần")</td>
                        </tr>
                    </tbody>
                </table>

                <div class="alert alert-info mb-0">
                    Đây mới là kết quả AI hiểu nhu cầu.
                    Bước tiếp theo sẽ tìm sự kiện thật
                    trong SQL Server và xếp hạng Top-N.
                </div>
            </div>
        </div>
    }
</div>

@{
    var top3 = ViewBag.Top3
        as VeSuKienWeb.Models.KhamPhaSuKien.KetQuaKhamPha;
}

@if (top3 != null)
{
    <div class="container mt-4 mb-5"
         style="max-width:950px;">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-1">
                    3 sự kiện phù hợp nhất
                </h3>

                <p class="text-muted mb-0">
                    Kết quả tìm từ dữ liệu thật
                    trong SQL Server.
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(top3.ThongBao))
        {
            <div class="alert alert-info">
                @top3.ThongBao
            </div>
        }

        @if (top3.DanhSach.Count > 0)
        {
            <div class="row g-3">
                @foreach (var sk in top3.DanhSach)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0">

                            @if (!string.IsNullOrWhiteSpace(sk.AnhSuKien))
                            {
                                <img src="@sk.AnhSuKien"
                                     alt="@sk.TenSuKien"
                                     class="card-img-top"
                                     style="height:175px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex
                                            align-items-center
                                            justify-content-center"
                                     style="height:175px;">
                                    <span class="text-muted">
                                        Chưa có ảnh sự kiện
                                    </span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">

                                <h5 class="card-title fw-bold">
                                    @sk.TenSuKien
                                </h5>

                                <p class="small text-muted mb-2">
                                    <strong>Chủ đề:</strong>
                                    @(string.IsNullOrWhiteSpace(sk.ChuDe)
                                        ? "Chưa phân loại"
                                        : sk.ChuDe)
                                </p>

                                <p class="small mb-2">
                                    <strong>Thời gian:</strong>
                                    @sk.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")
                                </p>

                                <p class="small mb-2">
                                    <strong>Địa điểm:</strong>
                                    @sk.DiaDiem
                                </p>

                                <p class="fw-bold text-primary mb-2">
                                    @if (sk.GiaVeThapNhat.HasValue)
                                    {
                                        <span>
                                            Vé từ
                                            @sk.GiaVeThapNhat.Value.ToString("N0") đ
                                        </span>
                                    }
                                    else
                                    {
                                        <span>Chưa có thông tin giá</span>
                                    }
                                </p>

                                <p class="small text-success">
                                    <strong>Phù hợp vì:</strong>
                                    @sk.LyDoPhuHop
                                </p>

@if (sk.LaGoiYMoRong)
{
    <div class="alert alert-warning small mt-2">
        <strong>Gợi ý mở rộng:</strong>
        Sự kiện này chưa đáp ứng đầy đủ yêu cầu.

        @if (!string.IsNullOrWhiteSpace(
            sk.DieuKienChuaKhop))
        {
            <div class="mt-1">
                <strong>Chưa khớp:</strong>
                @sk.DieuKienChuaKhop
            </div>
        }
    </div>
}

                                <div class="mt-auto">
                                    <span class="badge bg-secondary">
                                        Điểm xếp hạng:
                                        @sk.DiemPhuHop.ToString("0.##")
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

