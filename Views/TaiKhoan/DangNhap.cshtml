@model VeSuKienWeb.Models.TaiKhoan.DangNhapYeuCau
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
.login-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fbff;
}

.login-card {
    width: 100%;
    max-width: 460px;
    background: #fff;
    border-radius: 18px;
    padding: 40px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 8px 30px rgba(0,0,0,.05);
}

.login-title {
    font-size: 30px;
    font-weight: 700;
    color: #2563eb;
    text-align: center;
    margin-bottom: 8px;
}

.login-subtitle {
    text-align: center;
    color: #64748b;
    font-size: 14px;
}

.form-label {
    font-weight: 600;
    color: #334155;
    margin-bottom: 8px;
}

.form-control {
    height: 50px;
    border-radius: 10px;
    border: 1px solid #dbeafe;
    background: #fff;
}

.form-control:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,.12);
}

.password-wrapper {
    position: relative;
}

.password-wrapper .form-control {
    padding-right: 50px;
}

.password-toggle {
    position: absolute;
    top: 50%;
    right: 15px;
    transform: translateY(-50%);
    border: none;
    background: transparent;
    color: #64748b;
    font-size: 18px;
    cursor: pointer;
    padding: 0;
}

.password-toggle:hover {
    color: #2563eb;
}

.btn-area {
    margin-top: 24px;
}

.btn-login {
    width: 100%;
    height: 50px;
    border: none;
    border-radius: 12px;
    background: #2563eb;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    transition: .25s ease;
}

.btn-login:hover {
    background: #1d4ed8;
}

.login-footer {
    text-align: center;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #eef2ff;
}

.alert-danger {
    border-radius: 10px;
    font-size: 14px;
}
</style>

<div class="login-page">
    <div class="login-card">

        <div class="text-center mb-4">
            <h2 class="login-title">Đăng nhập</h2>
            <p class="login-subtitle">
                Đăng nhập để tiếp tục sử dụng hệ thống đặt vé sự kiện
            </p>
        </div>

        <form asp-action="DangNhap" method="post">

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Nhập email của bạn" />
                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label">Mật khẩu</label>

                <div class="password-wrapper">
                    <input asp-for="MatKhau"
                           type="password"
                           id="passwordInput"
                           class="form-control"
                           placeholder="Nhập mật khẩu" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword()">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>

                <span asp-validation-for="MatKhau"
                      class="text-danger small"></span>
            </div>

            <div class="btn-area">
                <button type="submit" class="btn-login">
                    Đăng nhập
                </button>
            </div>

        </form>

        <div class="login-footer">
            <span class="text-muted">Chưa có tài khoản?</span>
            <a asp-controller="TaiKhoan"
               asp-action="DangKy">Đăng ký ngay</a>
        </div>

    </div>
</div>

<script>
function togglePassword() {

    const password = document.getElementById("passwordInput");
    const icon = document.getElementById("eyeIcon");

    if (password.type === "password") {

        password.type = "text";

        icon.classList.remove("bi-eye");
        icon.classList.add("bi-eye-slash");

    } else {

        password.type = "password";

        icon.classList.remove("bi-eye-slash");
        icon.classList.add("bi-eye");
    }
}
</script>