
@model VeSuKienWeb.Models.TaiKhoan.DangNhapYeuCau

@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    .login-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background: transparent;
        padding: 40px 16px;
    }

    .login-page::before,
    .login-page::after {
        content: "";
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        filter: blur(55px);
        pointer-events: none;
    }

    .login-page::before {
        width: 250px;
        height: 250px;
        background: rgba(190, 137, 220, .18);
        top: 4%;
        left: 6%;
    }

    .login-page::after {
        width: 280px;
        height: 280px;
        background: rgba(239, 163, 209, .17);
        bottom: 0;
        right: 5%;
    }

    .login-card {
        width: 100%;
        max-width: 470px;
        position: relative;
        overflow: hidden;

        background: rgba(255, 255, 255, .92);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, .95);
        padding: 39px 38px;

        box-shadow:
            0 18px 55px rgba(92, 52, 116, .13),
            0 4px 15px rgba(92, 52, 116, .05);
    }

 

    .login-heading-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 19px;
        background: linear-gradient(
            135deg,
            #f0e2f8,
            #fbe8f4
        );

        color: #9154ad;
        font-size: 27px;
        box-shadow: 0 5px 16px rgba(145, 84, 173, .10);
    }

    .login-title {
        font-size: 30px;
        font-weight: 800;
        color: #754394;
        text-align: center;
        margin-bottom: 9px;
        letter-spacing: -.5px;
    }

    .login-subtitle {
        text-align: center;
        color: #927da0;
        font-size: 14px;
        line-height: 1.65;
        margin-bottom: 29px;
    }

    .login-page .form-label {
        display: block;
        font-weight: 700;
        color: #594166;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .login-page .form-control {
        width: 100%;
        height: 49px;
        border-radius: 12px;
        border: 1px solid #e7d9ef;
        background: rgba(250, 247, 253, .9);
        color: #44304f;
        padding: 10px 14px;
        font-size: 14px;
        box-shadow: none;
        transition: border-color .2s ease,
                    box-shadow .2s ease,
                    background .2s ease;
    }

    .login-page .form-control::placeholder {
        color: #b09db9;
        font-size: 13px;
    }

    .login-page .form-control:focus {
        border-color: #b47acb;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(180, 122, 203, .13);
        outline: none;
    }

    .login-page .password-wrapper {
        position: relative;
    }

    .login-page .password-wrapper .form-control {
        padding-right: 50px;
    }

    .login-page .password-toggle {
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #a58ab3;
        font-size: 18px;
        cursor: pointer;
        padding: 5px;
        transition: color .2s ease;
    }

    .login-page .password-toggle:hover {
        color: #8950a7;
    }

    .login-page .btn-area {
        margin-top: 25px;
    }

    .login-page .btn-login {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 13px;

        background: linear-gradient(
            110deg,
            #9560b5 0%,
            #b66fc2 55%,
            #d47eae 100%
        );

        color: #fff;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: .2px;

        box-shadow: 0 7px 18px rgba(153, 91, 183, .23);
        transition: transform .22s ease,
                    box-shadow .22s ease,
                    filter .22s ease;

        cursor: pointer;
    }

    .login-page .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 23px rgba(153, 91, 183, .29);
        filter: brightness(1.04);
    }

    .login-page .btn-login:active {
        transform: translateY(0);
    }

    .login-page .login-footer {
        text-align: center;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #f0e6f4;
        font-size: 13px;
        color: #8c7a97;
    }

    .login-page .login-footer a {
        color: #9256ae;
        font-weight: 800;
        text-decoration: none;
        margin-left: 4px;
        transition: color .2s ease;
    }

    .login-page .login-footer a:hover {
        color: #c16fae;
        text-decoration: underline;
    }

    .login-page .alert-danger {
        border: 1px solid #f2cbd9;
        border-radius: 12px;
        background: #fff3f7;
        color: #b94e75;
        font-size: 13px;
        padding: 12px 14px;
        margin-bottom: 19px;
    }

    .login-page .text-danger.small {
        display: block;
        font-size: 11px;
        margin-top: 5px;
        color: #d45d82 !important;
    }

    @@media (max-width: 576px) {
        .login-page {
            min-height: auto;
            padding: 28px 13px;
        }

        .login-card {
            padding: 31px 22px;
            border-radius: 20px;
        }

        .login-title {
            font-size: 27px;
        }
    }
.remember-login {
    display: flex;
    align-items: center;
    gap: 12px !important;
    margin-top: 15px;
    margin-bottom: 5px;
}

/* Ẩn input phụ do Razor tự sinh */
.remember-login input[type="hidden"] {
    display: none !important;
}

.remember-login .remember-checkbox {
    display: block;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    margin: 0 4px 0 0 !important;
    padding: 0;
    accent-color: #a66bc2;
    cursor: pointer;
}

.remember-login label {
    display: inline-block;
    margin: 0 !important;
    padding: 0;
    line-height: 20px;
    color: #806b8c;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

.remember-login label:hover {
    color: #9256ae;
}
</style>

<div class="login-page">
    <div class="login-card">

        <div class="text-center mb-4">

            <div class="login-heading-icon">
                <i class="bi bi-person-lock"></i>
            </div>

            <h2 class="login-title">Đăng nhập</h2>

            <p class="login-subtitle">
                Đăng nhập để tiếp tục sử dụng hệ thống đặt vé sự kiện.
            </p>

        </div>

        <form asp-action="DangNhap" method="post">

            @if (!ViewData.ModelState.IsValid &&
                 ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="mb-3">

                <label asp-for="Email" class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Nhập email của bạn" />

                <span asp-validation-for="Email"
                      class="text-danger small"></span>

            </div>

            <div class="mb-3">

                <label asp-for="MatKhau" class="form-label">
                    Mật khẩu
                </label>

                <div class="password-wrapper">

                    <input asp-for="MatKhau"
                           type="password"
                           id="passwordInput"
                           class="form-control"
                           placeholder="Nhập mật khẩu" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword()"
                            aria-label="Hiện hoặc ẩn mật khẩu">

                        <i class="bi bi-eye" id="eyeIcon"></i>

                    </button>

                </div>

                <span asp-validation-for="MatKhau"
                      class="text-danger small"></span>

            </div>

<div class="remember-login">
    <label class="remember-label">
        <input type="checkbox"
               id="GhiNhoDangNhap"
               name="GhiNhoDangNhap"
               value="true" />

        <label asp-for="GhiNhoDangNhap">
        <span>Ghi nhớ đăng nhập</span>
    </label>

    <input type="hidden"
           name="GhiNhoDangNhap"
           value="false" />
</div>

            <div class="btn-area">

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>
                    Đăng nhập
                </button>

            </div>

        </form>

        <div class="login-footer">

            <span>Chưa có tài khoản?</span>

            <a asp-controller="TaiKhoan"
               asp-action="DangKy">
                Đăng ký ngay
            </a>

        </div>

    </div>
</div>

<script>
    function togglePassword() {

        const password = document.getElementById("passwordInput");
        const icon = document.getElementById("eyeIcon");

        if (!password || !icon) return;

        if (password.type === "password") {

            password.type = "text";

            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");

        } else {

            password.type = "password";

            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");
        }
    }
</script>
