
@model VeSuKienWeb.Models.KhachHang.VeCuaToiItemVM

@{
    ViewData["Title"] = "Chi tiết vé";

    string trangThai = Model.TrangThaiVe switch
    {
        "DaThanhToan" => "Đã thanh toán",
        "ChuaThanhToan" => "Chưa thanh toán",
        "DaHuy" => "Đã hủy",
        "Huy" => "Đã hủy",
        "HoanTien" => "Đã hoàn tiền",
        "DaHoanTien" => "Đã hoàn tiền",
        _ => Model.TrangThaiVe
    };

    string statusClass = Model.TrangThaiVe switch
    {
        "DaThanhToan" => "paid",
        "ChuaThanhToan" => "pending",
        "DaHuy" => "cancelled",
        "Huy" => "cancelled",
        "HoanTien" => "refunded",
        "DaHoanTien" => "refunded",
        _ => "default"
    };

    string viTriGhe = !string.IsNullOrWhiteSpace(Model.DanhSachGhe)
        ? Model.DanhSachGhe
        : (Model.Hang != null && Model.Cot.HasValue
            ? $"{Model.Hang}{Model.Cot}"
            : "Ghế tự do");

    var danhSachGhe = !string.IsNullOrWhiteSpace(Model.DanhSachGhe)
        ? Model.DanhSachGhe
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .ToList()
        : new List<string> { viTriGhe };

    int soLuongVe = danhSachGhe.Count;

    decimal giaTungVe = soLuongVe > 0
        ? Model.GiaVe / soLuongVe
        : Model.GiaVe;

    string loaiSuKienHienThi = Model.LaTrucTiep
        ? "Sự kiện trực tiếp"
        : (Model.LaTrucTuyen
            ? "Sự kiện trực tuyến"
            : Model.TenLoaiSuKien);

    bool cungNgay =
        Model.ThoiGianBatDau.Date ==
        Model.ThoiGianKetThuc.Date;

    string thoiGianDienRa = cungNgay
        ? $"{Model.ThoiGianBatDau:dd/MM/yyyy} | {Model.ThoiGianBatDau:HH:mm} – {Model.ThoiGianKetThuc:HH:mm}"
        : $"{Model.ThoiGianBatDau:dd/MM/yyyy HH:mm} – {Model.ThoiGianKetThuc:dd/MM/yyyy HH:mm}";
}

<style>
    .ticket-detail-page,
    .ticket-detail-page * {
        box-sizing: border-box;
    }

    .ticket-detail-page {
        min-height: calc(100vh - 170px);
        padding: 28px 0 32px;
        background: transparent;
        color: #30283c;
        font-family: "Be Vietnam Pro", sans-serif;
    }

    .ticket-detail-container {
        width: 100%;
        max-width: 880px;
        margin: 0 auto;
        padding: 0 16px;
    }

    .ticket-detail-card {
        background: #ffffff;
        border-radius: 17px;
        overflow: hidden;
        box-shadow: 0 13px 35px rgba(66, 37, 86, .09);
    }

    .ticket-detail-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, .95fr);
        align-items: start;
        gap: 26px;
        padding: 24px 27px 16px;
    }

    .ticket-detail-left,
    .ticket-detail-right {
        min-width: 0;
    }

    /* TRANG THAI */

    .ticket-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .ticket-status-badge::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .ticket-status-badge.paid {
        color: #197044;
        background: #e9f8ee;
    }

    .ticket-status-badge.pending {
        color: #966d1b;
        background: #fff4db;
    }

    .ticket-status-badge.cancelled {
        color: #64748b;
        background: #f1f3f6;
    }

    .ticket-status-badge.refunded {
        color: #246b96;
        background: #e8f4fb;
    }

    .ticket-status-badge.default {
        color: #79569b;
        background: #f1ebf8;
    }

    /* TEN SU KIEN */

    .ticket-event-title {
        margin: 0 0 5px;
        color: #241b32;
        font-size: 22px;
        line-height: 1.4;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .ticket-event-type {
        margin-bottom: 19px;
        font-size: 12px;
        font-weight: 500;
        color: #845e99;
    }

    /* THONG TIN VE */

    .ticket-info-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .ticket-info-row {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        align-items: start;
        gap: 12px;
    }

    .ticket-info-label {
        color: #81768d;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.7;
    }

    .ticket-info-value {
        color: #332a40;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.7;
        text-align: left;
        overflow-wrap: anywhere;
    }

    .ticket-code-value {
        color: #745197;
        font-size: 11.5px;
        font-weight: 700;
    }

    /* DIA DIEM */

    .ticket-section-heading {
        margin: 2px 0 12px;
        color: #30263f;
        font-size: 13px;
        font-weight: 700;
    }

    .ticket-location,
    .ticket-online-info {
        margin-bottom: 22px;
    }

    .ticket-location-name,
    .ticket-online-platform {
        color: #352b42;
        font-size: 12.5px;
        font-weight: 600;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .ticket-location-address {
        margin-top: 4px;
        color: #81758d;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .ticket-online-label {
        color: #81758d;
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .ticket-online-link {
        display: inline-block;
        margin-top: 8px;
        color: #8253a4;
        font-size: 12px;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
        overflow-wrap: anywhere;
    }

    .ticket-online-password {
        display: block;
        margin-top: 8px;
        color: #5f4b70;
        font-size: 12px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    /* DANH SACH GHE */

    .ticket-seat-title {
        margin: 0 0 12px;
        color: #30263f;
        font-size: 13px;
        font-weight: 700;
    }

    .ticket-seat-scroll {
        max-height: 135px;
        overflow-y: auto;
        scrollbar-width: thin;
    }

    .ticket-seat-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .ticket-seat-table th {
        padding: 6px 3px 10px;
        text-align: left;
        color: #92859d;
        font-size: 10.5px;
        font-weight: 600;
    }

    .ticket-seat-table td {
        padding: 8px 3px;
        color: #352b42;
        font-size: 11.5px;
        font-weight: 500;
        vertical-align: top;
        overflow-wrap: anywhere;
    }

    .ticket-seat-table th:first-child,
    .ticket-seat-table td:first-child {
        width: 34px;
    }

    .ticket-seat-table th:nth-child(3),
    .ticket-seat-table td:nth-child(3) {
        width: 51px;
    }

    .ticket-seat-table th:last-child,
    .ticket-seat-table td:last-child {
        width: 91px;
        text-align: right;
    }

    .ticket-seat-table .seat-position {
        color: #654b80;
        font-weight: 600;
    }

    .ticket-seat-table .seat-price {
        color: #352b42;
        font-weight: 600;
        white-space: nowrap;
    }

    /* TONG THANH TOAN */

    .ticket-total {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 15px;
    }

    .ticket-total-label {
        color: #30263f;
        font-size: 12.5px;
        font-weight: 800;
    }

    .ticket-total-price {
        color: #a04fb2;
        font-size: 20px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* FOOTER */

    .ticket-detail-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 13px 27px 19px;
        background: #ffffff;
    }

    .ticket-footer-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

    .ticket-back-btn,
    .ticket-cancel-btn,
    .ticket-qr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 35px;
        padding: 8px 14px;
        border-radius: 9px;
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s;
    }

    .ticket-back-btn {
        border: 1px solid #e0d6e9;
        background: #ffffff;
        color: #76558c;
    }

    .ticket-back-btn:hover {
        background: #f9f5fc;
        color: #6a4285;
        border-color: #c5acd4;
    }

    /* NUT HUY VE */

    .ticket-cancel-btn {
        border: 1px solid #dfb5bc;
        background: #ffffff;
        color: #ad5364;
    }

    .ticket-cancel-btn:hover {
        border-color: #c98591;
        background: #fff5f6;
        color: #9e4052;
    }

    /* NUT QR */

    .ticket-qr-btn {
        border: 1px solid transparent;
        background: linear-gradient(110deg, #9251b0, #bf67b6);
        color: #ffffff;
        font-weight: 700;
    }

    .ticket-qr-btn:hover {
        background: #9655a8;
        color: #ffffff;
    }

    /* LAPTOP */

    @@media (min-width: 851px) and (max-height: 760px) {
        .ticket-detail-page {
            padding: 16px 0 20px;
        }

        .ticket-detail-content {
            padding-top: 19px;
            padding-bottom: 10px;
        }

        .ticket-detail-footer {
            padding-top: 10px;
            padding-bottom: 13px;
        }

        .ticket-event-type {
            margin-bottom: 14px;
        }

        .ticket-info-list {
            gap: 11px;
        }

        .ticket-location,
        .ticket-online-info {
            margin-bottom: 16px;
        }
    }

    /* TABLET */

    @@media (max-width: 850px) {
        .ticket-detail-container {
            max-width: 600px;
        }

        .ticket-detail-content {
            grid-template-columns: 1fr;
            row-gap: 24px;
        }
    }

    /* MOBILE */

    @@media (max-width: 520px) {
        .ticket-detail-page {
            padding: 15px 0 25px;
        }

        .ticket-detail-container {
            padding: 0 12px;
        }

        .ticket-detail-content {
            padding: 19px 16px 10px;
            row-gap: 22px;
        }

        .ticket-event-title {
            font-size: 21px;
        }

        .ticket-info-row {
            grid-template-columns: 99px minmax(0, 1fr);
            gap: 9px;
        }

        .ticket-info-label,
        .ticket-info-value {
            font-size: 11.5px;
        }

        .ticket-code-value {
            font-size: 10.5px;
        }

        .ticket-seat-table th {
            font-size: 9.5px;
        }

        .ticket-seat-table td {
            font-size: 10.5px;
        }

        .ticket-total-price {
            font-size: 17px;
        }

        .ticket-detail-footer {
            padding: 10px 16px 16px;
        }

        .ticket-footer-actions {
            gap: 7px;
        }
    }
</style>

<div class="ticket-detail-page">

    <div class="ticket-detail-container">

        <div class="ticket-detail-card">

            <div class="ticket-detail-content">

                <!-- THONG TIN VE BEN TRAI -->

                <div class="ticket-detail-left">

                    <span class="ticket-status-badge @statusClass">
                        @trangThai
                    </span>

                    <h2 class="ticket-event-title">
                        @Model.TenSuKien
                    </h2>

                    <div class="ticket-event-type">
                        @loaiSuKienHienThi
                    </div>

                    <div class="ticket-info-list">

                        <div class="ticket-info-row">
                            <span class="ticket-info-label">
                                Mã vé
                            </span>

                            <span class="ticket-info-value ticket-code-value">
                                @Model.MaVe
                            </span>
                        </div>

                        <div class="ticket-info-row">
                            <span class="ticket-info-label">
                                Thời gian diễn ra
                            </span>

                            <span class="ticket-info-value">
                                @thoiGianDienRa
                            </span>
                        </div>

                        <div class="ticket-info-row">
                            <span class="ticket-info-label">
                                Ngày đặt vé
                            </span>

                            <span class="ticket-info-value">
                                @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                    </div>

                </div>

                <!-- DIA DIEM, DANH SACH GHE BEN PHAI -->

                <div class="ticket-detail-right">

                    @if (Model.LaTrucTiep)
                    {
                        <h3 class="ticket-section-heading">
                            Địa điểm tổ chức
                        </h3>

                        <div class="ticket-location">

                            <div class="ticket-location-name">
                                @Model.DiaDiem
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.DiaChi))
                            {
                                <div class="ticket-location-address">
                                    @Model.DiaChi
                                </div>
                            }

                        </div>
                    }
                    else if (Model.LaTrucTuyen)
                    {
                        <h3 class="ticket-section-heading">
                            Thông tin tham gia trực tuyến
                        </h3>

                        <div class="ticket-online-info">

                            <div class="ticket-online-label">
                                Nền tảng
                            </div>

                            <div class="ticket-online-platform">
                                @Model.OnlineNenTang
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.OnlineLinkXem))
                            {
                                <a href="@Model.OnlineLinkXem"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="ticket-online-link">
                                    Liên kết tham gia trực tuyến
                                </a>
                            }

                            @if (Model.TrangThaiVe == "DaThanhToan" &&
                                 !string.IsNullOrWhiteSpace(Model.OnlineMatKhau))
                            {
                                <span class="ticket-online-password">
                                    Mật khẩu: @Model.OnlineMatKhau
                                </span>
                            }

                        </div>
                    }

                    <h3 class="ticket-seat-title">
                        Danh sách vé đã đặt
                    </h3>

                    <div class="ticket-seat-scroll">

                        <table class="ticket-seat-table">

                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Ghế</th>
                                    <th>Loại vé</th>
                                    <th>Giá vé</th>
                                </tr>
                            </thead>

                            <tbody>
                                @for (int i = 0; i < danhSachGhe.Count; i++)
                                {
                                    <tr>
                                        <td>@(i + 1)</td>

                                        <td>
                                            <span class="seat-position">
                                                @(danhSachGhe[i] == "Ghế tự do"
                                                    ? "Ghế tự do"
                                                    : $"Ghế {danhSachGhe[i]}")
                                            </span>
                                        </td>

                                        <td>
                                            @Model.TenLoaiVe
                                        </td>

                                        <td class="seat-price">
                                            @giaTungVe.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>

                    <div class="ticket-total">

                        <span class="ticket-total-label">
                            Tổng thanh toán
                        </span>

                        <span class="ticket-total-price">
                            @Model.GiaVe.ToString("N0") đ
                        </span>

                    </div>

                </div>

            </div>

            <!-- CAC NUT CHUC NANG -->

            <div class="ticket-detail-footer">

                <a asp-controller="KhachHang"
                   asp-action="VeCuaToi"
                   class="ticket-back-btn">
                    Quay lại danh sách vé
                </a>

                <div class="ticket-footer-actions">

                    @if (Model.CoTheHuy)
                    {
                        <a asp-controller="KhachHang"
                           asp-action="YeuCauHoanHuy"
                           asp-route-veId="@Model.VeId"
                           class="ticket-cancel-btn">

                            Hủy vé

                        </a>
                    }

                    @if (Model.LaTrucTiep && Model.DuocXemQr)
                    {
                        <a asp-controller="KhachHang"
                           asp-action="XemMaQr"
                           asp-route-veId="@Model.VeId"
                           class="ticket-qr-btn">

                            Xem mã QR

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
