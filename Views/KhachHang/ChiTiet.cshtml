@model VeSuKienWeb.Models.KhachHang.SuKienChiTietKhVM

@{
    var sk = Model.SuKien;
    var loai = Model.LoaiSuKien;
    var toChuc = Model.ToChuc;
    var diaDiem = Model.DiaDiem;
    var online = Model.SuKienTrucTuyen;

    ViewData["Title"] = "Chi tiết sự kiện";

    bool daDangNhap = User?.Identity?.IsAuthenticated ?? false;
    bool laKhachHang = User?.IsInRole("KhachHang") ?? false;

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<link rel="stylesheet"
      href="~/css/admin-chi-tiet-su-kien.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/khachhang-chi-tiet.css"
      asp-append-version="true" />

<!-- Đồng bộ font chữ trang chi tiết sự kiện -->
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet" />

<style>
    .kh-event-detail,
    .kh-event-detail h1,
    .kh-event-detail h2,
    .kh-event-detail h3,
    .kh-event-detail h4,
    .kh-event-detail h5,
    .kh-event-detail h6,
    .kh-event-detail p,
    .kh-event-detail span,
    .kh-event-detail div,
    .kh-event-detail strong,
    .kh-event-detail a,
    .kh-event-detail button,
    .kh-event-detail table,
    .kh-event-detail th,
    .kh-event-detail td,
    .kh-event-detail small,
    .kh-event-detail em {
        font-family: "Be Vietnam Pro", sans-serif !important;
    }
</style>

<div class="kh-event-detail">

    <div class="kh-event-hero">
        <div class="kh-event-hero-body">
            <div class="kh-event-photo">
                @if (!string.IsNullOrWhiteSpace(sk.AnhSuKien))
                {
                    <img src="@Url.Content(sk.AnhSuKien)"
                         alt="Ảnh sự kiện @sk.TenSuKien"
                         loading="lazy" />
                }
                else
                {
                    <div class="kh-event-photo-empty">
                        Sự kiện chưa có ảnh đại diện
                    </div>
                }
            </div>

            <div>
                <div class="kh-event-badges">
                    @if (loai != null)
                    {
                        <span class="badge bg-secondary">@loai.TenLoai</span>
                    }

                    <span class="badge bg-light text-dark border">
                        Mã sự kiện #@sk.SuKienId
                    </span>

                    @if (Model.CoTheDatVe)
                    {
                        <span class="badge bg-success">Đang mở đặt vé</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã kết thúc</span>
                    }
                </div>

                <h2 class="kh-event-title">@sk.TenSuKien</h2>

                <div class="kh-event-meta">
                    <div class="kh-meta-box">
                        <span>Thời gian bắt đầu</span>
                        <strong>@sk.ThoiGianBatDau.ToString("HH:mm dd/MM/yyyy")</strong>
                    </div>

                    <div class="kh-meta-box">
                        <span>Thời gian kết thúc</span>
                        <strong>@sk.ThoiGianKetThuc.ToString("HH:mm dd/MM/yyyy")</strong>
                    </div>

                    <div class="kh-meta-box">
                        <span>Đơn vị tổ chức</span>
                        <strong>@(toChuc?.TenToChuc ?? "Chưa cập nhật")</strong>
                    </div>

                    <div class="kh-meta-box">
                        <span>Địa điểm / Hình thức</span>
                        <strong>
                            @(diaDiem != null
                                ? diaDiem.TenDiaDiem
                                : online != null
                                    ? "Sự kiện trực tuyến"
                                    : "Chưa cập nhật")
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <strong>Giới thiệu sự kiện</strong>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(sk.MoTaChiTiet))
                    {
                        <div class="kh-preline">@sk.MoTaChiTiet</div>
                    }
                    else
                    {
                        <p class="text-muted mb-0"><em>Chưa có mô tả chi tiết.</em></p>
                    }
                </div>
            </div>

            @if (diaDiem != null)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-light">
                        <strong>Thông tin sự kiện trực tiếp</strong>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Địa điểm:</strong> @diaDiem.TenDiaDiem</p>
                        <p class="mb-1"><strong>Địa chỉ:</strong> @diaDiem.DiaChi</p>
                        <p class="mb-1"><strong>Tổng số ghế:</strong> @diaDiem.SoChoNgoi</p>

                        @if (!string.IsNullOrWhiteSpace(diaDiem.BanDo))
                        {
                            <p class="mb-0">
                                <strong>Bản đồ:</strong>
                                <a href="@diaDiem.BanDo" target="_blank" rel="noopener noreferrer">
                                    Mở Google Maps
                                </a>
                            </p>
                        }
                    </div>
                </div>

                <div class="aed-card aed-map-card mb-4">
                    <div class="aed-card-head">
                        <div>
                            <h2>Sơ đồ chỗ ngồi</h2>
                            <div class="aed-map-intro">
                                Bạn có thể xem sơ đồ ghế trước khi đặt vé.
                                Muốn đặt vé thì cần đăng nhập tài khoản Khách hàng.
                            </div>
                        </div>

                        <div class="aed-map-tools">
                            <button type="button"
                                    id="adminSeatZoomOut"
                                    class="btn btn-outline-secondary btn-sm">
                                Thu nhỏ
                            </button>

                            <span id="adminSeatZoomValue" class="aed-muted">
                                100%
                            </span>

                            <button type="button"
                                    id="adminSeatZoomIn"
                                    class="btn btn-outline-secondary btn-sm">
                                Phóng to
                            </button>

                            <button type="button"
                                    id="adminSeatZoomReset"
                                    class="btn btn-outline-secondary btn-sm">
                                Mặc định
                            </button>
                        </div>
                    </div>

                    <div class="aed-card-body">
                        <div id="adminSeatViewport" class="aed-map-viewport">
                            <svg id="adminSeatMap"
                                 class="aed-seat-svg"
                                 viewBox="0 0 1000 700"
                                 xmlns="http://www.w3.org/2000/svg"
                                 role="img"
                                 aria-label="Sơ đồ chỗ ngồi sự kiện">
                            </svg>

                            <div id="adminSeatEmpty"
                                 class="aed-map-empty"
                                 hidden>
                                Sự kiện này chưa có sơ đồ chỗ ngồi.
                            </div>
                        </div>

                        <div class="aed-map-legend">
                            <div class="aed-legend-item">
                                <span class="aed-legend-dot"
                                      style="background:#ffffff;border:2px solid #d4a51e"></span>
                                Ghế VIP
                            </div>

                            <div class="aed-legend-item">
                                <span class="aed-legend-dot"
                                      style="background:#ffffff;border:2px solid #80c783"></span>
                                Ghế Thường
                            </div>

                            <div class="aed-legend-item">
                                <span class="aed-legend-dot"
                                      style="background:#e0e5eb"></span>
                                Ghế đã đặt
                            </div>
                        </div>

                        <div class="aed-info-grid mt-3">
                            <div class="aed-info">
                                <span>Tổng số ghế</span>
                                <strong id="adminSeatTotal">—</strong>
                            </div>

                            <div class="aed-info">
                                <span>Số ghế đã đặt</span>
                                <strong id="adminSeatBooked">—</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (online != null)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-light">
                        <strong>Sự kiện trực tuyến</strong>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Nền tảng:</strong> @online.NenTang</p>

                        <p class="mb-2 text-muted small">
                            Link tham gia và mật khẩu phòng sẽ được hiển thị sau khi bạn đặt vé và thanh toán thành công.
                        </p>

                        @if (!string.IsNullOrWhiteSpace(online.HuongDan))
                        {
                            <div>
                                <strong>Hướng dẫn:</strong>
                                <div class="kh-preline mt-1">@online.HuongDan</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="kh-side-sticky">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-light">
                        <strong>Thông tin vé</strong>
                    </div>
                    <div class="card-body">
                        @if (Model.LoaiVes != null && Model.LoaiVes.Any())
                        {
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Loại vé</th>
                                        <th>Giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lv in Model.LoaiVes)
                                    {
                                        <tr>
                                            <td>@lv.TenLoai</td>
                                            <td>@lv.GiaVe.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted mb-0"><em>Chưa cấu hình loại vé.</em></p>
                        }
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-body text-center">
                        @if (TempData["ThongBao"] != null)
                        {
                            <div class="alert alert-info py-2 mb-3">
                                @TempData["ThongBao"]
                            </div>
                        }

                        @if (Model.CoTheDatVe)
                        {
                            @if (!daDangNhap)
                            {
                                <a asp-controller="TaiKhoan"
                                   asp-action="DangNhap"
                                   asp-route-returnUrl="@returnUrl"
                                   class="btn btn-primary w-100 mb-2">
                                    Đăng nhập để đặt vé
                                </a>

                                <div class="small text-muted">
                                    Bạn vẫn có thể xem sơ đồ ghế, nhưng cần đăng nhập tài khoản Khách hàng để đặt vé.
                                </div>
                            }
                            else if (laKhachHang)
                            {
                                <a asp-action="DatVe"
                                   asp-route-id="@sk.SuKienId"
                                   class="btn btn-primary w-100 mb-2">
                                    Đặt vé ngay
                                </a>

                                <div class="small text-muted">
                                    Vui lòng chọn vé hoặc ghế ở bước tiếp theo và hoàn tất thanh toán trong thời gian quy định.
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark mb-2">
                                    Bạn không phải tài khoản Khách hàng
                                </span>

                                <div class="small text-muted">
                                    Vui lòng đăng xuất và đăng nhập bằng tài khoản Khách hàng để đặt vé.
                                </div>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary mb-2">
                                Sự kiện đã kết thúc · Không thể đặt vé
                            </span>

                            <div class="small text-muted">
                                Bạn vẫn có thể xem thông tin và sơ đồ sự kiện.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="adminSeatMapData"
        type="application/json">@Html.Raw(ViewBag.SoDoJson ?? "null")</script>

<script src="~/js/admin-chi-tiet-so-do.js"
        asp-append-version="true"></script>