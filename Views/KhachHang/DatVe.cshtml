
@model VeSuKienWeb.Models.KhachHang.DatVeKhVM

@{
    ViewData["Title"] = "Đặt vé";
    var soDoJson = ViewBag.SoDoJson as string ?? "null";
}

<link rel="stylesheet"
      href="~/css/khachhang-dat-ve.css"
      asp-append-version="true" />

<div class="booking-page">
    <div class="booking-heading">
        <div>
            <span class="booking-eyebrow">ĐẶT VÉ SỰ KIỆN</span>
            <h2>@Model.TenSuKien</h2>
            <p>Chọn vị trí chỗ ngồi phù hợp và hoàn tất đặt vé của bạn.</p>
        </div>

        <a asp-action="ChiTiet" asp-route-id="@Model.SuKienId"
           class="booking-back">
            <i class="bi bi-arrow-left"></i> Chi tiết sự kiện
        </a>
    </div>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-info">
            @TempData["ThongBao"]
        </div>
    }

    <form asp-action="DatVe" method="post" id="bookingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SuKienId" />
        <input type="hidden" asp-for="LaSuKienTrucTiep" />
        <input type="hidden" asp-for="LaWorkshop" />

        @if (Model.LaSuKienTrucTiep)
        {
            <div class="booking-layout">
                <section class="booking-main">

                    <div class="booking-card">
                        <div class="booking-card-heading">
                            <div>
                                <h4>Sơ đồ chỗ ngồi</h4>
                                <p>Chọn ghế trống trực tiếp trên sơ đồ.</p>
                            </div>

                            <span class="seat-live-label">
                                <span></span> Sơ đồ sự kiện
                            </span>
                        </div>

                        <div class="booking-selection-hint">
                            <i class="bi bi-info-circle"></i>
                            Bạn được chọn tối đa <strong>10 ghế</strong> trong một lần đặt.
                            Ghế màu xám là ghế đã được đặt.
                        </div>

                        <div class="seat-legend">
                            <span><i class="legend-vip"></i> Ghế VIP</span>
                            <span><i class="legend-normal"></i> Ghế thường</span>
                            <span><i class="legend-booked"></i> Đã đặt</span>
                            <span><i class="legend-selected"></i> Đang chọn</span>
                        </div>

                        <div class="seat-toolbar">
                            <span>Phóng to sơ đồ để xem rõ vị trí ghế</span>

                            <div>
                                <button type="button" id="bookingZoomOut"
                                        title="Thu nhỏ">−</button>

                                <span id="bookingZoomValue">100%</span>

                                <button type="button" id="bookingZoomIn"
                                        title="Phóng to">+</button>

                                <button type="button" id="bookingZoomReset"
                                        title="Mặc định">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            </div>
                        </div>

                        <div class="booking-canvas" id="bookingCanvas">
                            <div class="booking-map" id="bookingMap">
                                <div class="booking-map-empty">
                                    Đang tải sơ đồ chỗ ngồi...
                                </div>
                            </div>
                        </div>

                        <div id="bookingSeatMessage"
                             class="booking-empty-message" hidden>
                            Sơ đồ chưa có dữ liệu. Vui lòng liên hệ Ban tổ chức.
                        </div>

                        <div class="booking-seat-count">
                            <span>
                                Tổng số ghế:
                                <strong id="totalSeats">0</strong>
                            </span>

                            <span>
                                Ghế còn trống:
                                <strong id="availableSeats">0</strong>
                            </span>

                            <span>
                                Ghế đã đặt:
                                <strong id="bookedSeats">0</strong>
                            </span>
                        </div>
                    </div>

                </section>

                <aside class="booking-sidebar">
                    <div class="booking-card ticket-card">
                        <div class="booking-card-heading">
                            <div>
                                <h4>Thông tin thanh toán</h4>
                                <p>Thông tin ghế và chi phí đặt vé.</p>
                            </div>
                        </div>

                        <div class="booking-payment-summary">
                            <div class="payment-summary-item">
                                <span>Số lượng ghế</span>
                                <strong>
                                    <span id="selectedCount">0</span>/10
                                </strong>
                            </div>

          

                            <div id="selectedTicketDetails"
                                 class="ticket-details">
                                <p class="text-muted">
                                    Chưa có ghế được chọn.
                                </p>
                            </div>
                        </div>

                        <div class="ticket-total">
                            <span>Tổng tiền</span>
                            <strong id="bookingTotal">0 đ</strong>
                        </div>

                        <button type="submit" class="booking-submit">
                            Tiếp tục thanh toán
                            <i class="bi bi-arrow-right"></i>
                        </button>

                        <p class="booking-note">
                            Vui lòng kiểm tra mã ghế và tổng tiền trước khi tiếp tục.
                        </p>
                    </div>

                    <div class="booking-card">
                        <h5 class="booking-note-title">
                            <i class="bi bi-info-circle"></i> Lưu ý
                        </h5>

                        <ul class="booking-notes">
                            <li>Chỉ có thể chọn ghế còn trống.</li>
                            <li>Ghế VIP và ghế thường có mức giá khác nhau.</li>
                            <li>Kiểm tra kỹ vị trí ghế trước khi thanh toán.</li>
                        </ul>
                    </div>
                </aside>
            </div>

            <script type="application/json" id="bookingSeatData">@Html.Raw(soDoJson)</script>
        }
        else
        {
            <div class="booking-layout">
                <section class="booking-main">
                    <div class="booking-card">
                        <h4>Thông tin vé trực tuyến</h4>

                        <p class="text-muted">
                            Hệ thống áp dụng loại vé mặc định cho sự kiện trực tuyến.
                        </p>

                        <input type="hidden" asp-for="LoaiVeId" />

                        <label asp-for="SoLuong" class="form-label">
                            Số lượng vé
                        </label>

                        <input asp-for="SoLuong" type="number"
                               min="1" max="10"
                               class="form-control" />

                        <span asp-validation-for="SoLuong"
                              class="text-danger"></span>

                        <p class="small text-muted mt-2">
                            Tối đa 10 vé mỗi lần đặt.
                        </p>

                        <button type="submit" class="booking-submit mt-3">
                            Tiếp tục thanh toán
                        </button>
                    </div>
                </section>

                <aside class="booking-sidebar">
                    <div class="booking-card">
                        <h5>Thông tin</h5>
                        <p class="small text-muted">
                            Link tham gia và mật khẩu phòng sẽ được cung cấp
                            sau khi thanh toán thành công.
                        </p>
                    </div>
                </aside>
            </div>
        }
    </form>
</div>

@section Scripts {
    <script src="~/js/khachhang-dat-ve.js"
            asp-append-version="true"></script>
}
