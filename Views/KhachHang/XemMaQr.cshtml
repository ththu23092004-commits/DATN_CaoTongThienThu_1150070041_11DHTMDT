
@model VeSuKienWeb.Models.KhachHang.MaQrVM

@{
    ViewData["Title"] = "Mã QR vé";
}

<style>
    /* =========================================
       TRANG XEM MA QR
       ========================================= */

    .qr-page,
    .qr-page * {
        box-sizing: border-box;
        font-family: "Be Vietnam Pro", sans-serif;
    }

    .qr-page {
        width: 100%;
        min-height: calc(100vh - 180px);
        padding: 20px 16px 24px;
        background: transparent;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .qr-wrap {
        width: 100%;
        max-width: 410px;
        margin: 0 auto;
    }

    /* =========================================
       THE QR
       ========================================= */

    .qr-card {
        width: 100%;
        padding: 23px 27px 24px;
        border-radius: 19px;
        background: #fffefd;
        border: 1px solid rgba(159, 121, 177, .15);
        text-align: center;
        box-shadow:
            0 13px 35px rgba(73, 45, 94, .085),
            0 3px 10px rgba(73, 45, 94, .025);
    }

    /* ICON PHIA TREN */

    .qr-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        margin: 0 auto 12px;
        border-radius: 13px;
        background: #f5eaf8;
        color: #885c9c;
        font-size: 21px;
    }

    /* TIEU DE */

    .qr-title {
        margin: 0 0 5px;
        color: #272031;
        font-size: 20px;
        line-height: 1.4;
        font-weight: 800;
    }

    .qr-subtitle {
        margin: 0 0 17px;
        color: #776b81;
        font-size: 11.5px;
        font-weight: 500;
        line-height: 1.6;
    }

    /* =========================================
       MA QR THAT - KHONG LAM MO
       ========================================= */

    .qr-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 230px;
        height: 230px;
        padding: 12px;
        margin: 0 auto 16px;
        border-radius: 15px;
        border: 1px solid #ece3ef;
        background: #ffffff;
    }

    .qr-box img {
        display: block;
        width: 100%;
        max-width: 205px;
        height: auto;
        object-fit: contain;
        image-rendering: auto;
    }

    /* =========================================
       MA VE
       ========================================= */

    .ticket-code-box {
        padding: 0;
        margin-bottom: 15px;
        background: transparent;
        border: none;
    }

    .ticket-code-label {
        margin-bottom: 5px;
        color: #867b8d;
        font-size: 10.5px;
        font-weight: 500;
    }

    .ticket-code {
        color: #292132;
        font-size: 12.5px;
        line-height: 1.5;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    /* =========================================
       LUU Y BAO MAT
       ========================================= */

    .qr-warning {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 8px;
        max-width: 335px;
        margin: 0 auto 18px;
        padding: 10px 12px;
        border-radius: 10px;
        background: #fbf5fa;
        color: #674a63;
        text-align: left;
    }

    .qr-warning i {
        flex: 0 0 auto;
        color: #a26391;
        font-size: 15px;
        margin-top: 1px;
    }

    .qr-warning span {
        color: #60495d;
        font-size: 11px;
        font-weight: 500;
        line-height: 1.6;
    }

    .qr-warning strong {
        color: #483448;
        font-weight: 700;
    }

    /* =========================================
       NUT QUAY LAI
       ========================================= */
.btn-qr-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    min-height: 40px;
    padding: 10px 16px;
    border: none;
    border-radius: 11px;
    background: linear-gradient(
        110deg,
        #9562B0 0%,
        #BC78B6 100%
    );
    color: #ffffff;
    font-family: "Be Vietnam Pro", sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 5px 13px rgba(149, 98, 176, 0.15);
    transition: all 0.2s ease;
}

.btn-qr-back:hover,
.btn-qr-back:focus-visible {
    background: linear-gradient(
        110deg,
        #c79cdf46 0%,
        #f18fede3 100%
    );
    color: #ffffff;
    box-shadow: 0 7px 17px rgba(149, 98, 176, 0.22);
}

.btn-qr-back i {
    font-size: 14px;
}

    /* =========================================
       QR HET HIEU LUC
       ========================================= */

    .expired-card {
        width: 100%;
        padding: 28px 27px;
        border-radius: 19px;
        background: #fffefd;
        border: 1px solid rgba(159, 121, 177, .15);
        text-align: center;
        box-shadow: 0 13px 35px rgba(73, 45, 94, .085);
    }

    .expired-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #fff3e4;
        color: #ae711e;
        font-size: 24px;
    }

    .expired-title {
        margin: 0 0 8px;
        color: #292132;
        font-size: 19px;
        font-weight: 750;
    }

    .expired-text {
        margin: 0 0 18px;
        color: #776b81;
        font-size: 12px;
        line-height: 1.65;
        font-weight: 500;
    }

    .expired-card .ticket-code-box {
        margin-bottom: 22px;
    }

    /* =========================================
       LAPTOP MAN HINH THAP
       ========================================= */

    @@media (min-width: 601px) and (max-height: 760px) {
        .qr-page {
            padding-top: 12px;
            padding-bottom: 12px;
        }

        .qr-card {
            padding: 16px 24px 17px;
        }

        .qr-header-icon {
            width: 37px;
            height: 37px;
            margin-bottom: 8px;
            font-size: 18px;
        }

        .qr-title {
            font-size: 18px;
        }

        .qr-subtitle {
            margin-bottom: 10px;
        }

.qr-box {
    width: 260px;
    height: 260px;
    margin: 0 auto 14px;
    padding: 0;
    border: 1px solid #ece3ef;
    border-radius: 14px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.qr-box img {
    display: block;
    width: 252px;
    height: 252px;
    max-width: none;
    object-fit: contain;
    image-rendering: pixelated;
}

        .ticket-code-box {
            margin-bottom: 10px;
        }

        .qr-warning {
            padding: 8px 10px;
            margin-bottom: 12px;
        }

        .btn-qr-back {
            min-height: 36px;
            padding: 8px 12px;
        }
    }

    /* =========================================
       MOBILE
       ========================================= */

    @@media (max-width: 480px) {
        .qr-page {
            padding: 15px 12px 24px;
        }

        .qr-card,
        .expired-card {
            padding: 21px 17px;
            border-radius: 16px;
        }

        .qr-title {
            font-size: 19px;
        }

        .qr-box {
            width: min(225px, 100%);
            height: auto;
            aspect-ratio: 1 / 1;
        }

        .qr-box img {
            max-width: 100%;
        }

        .qr-warning {
            padding: 10px;
        }
    }
    @@media (min-width: 601px) and (max-height: 760px) {
    .qr-box {
        width: 250px;
        height: 250px;
        padding: 0;
        margin-bottom: 10px;
    }

    .qr-box img {
        width: 242px;
        height: 242px;
        max-width: none;
    }
}

@@media (max-width: 480px) {
    .qr-box {
        width: min(260px, 100%);
        height: auto;
        aspect-ratio: 1;
        padding: 0;
    }

    .qr-box img {
        width: 97%;
        height: 97%;
        max-width: none;
    }
}
</style>

<div class="qr-page">
    <div class="qr-wrap">

        @if (Model.HetHieuLuc)
        {
            <div class="expired-card">

                <div class="expired-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h1 class="expired-title">
                    Không thể xem mã QR
                </h1>

                <p class="expired-text">
                    @(!string.IsNullOrWhiteSpace(Model.ThongBao)
                        ? Model.ThongBao
                        : "Sự kiện đã kết thúc nên mã QR không còn được hiển thị.")
                </p>

                <div class="ticket-code-box">
                    <div class="ticket-code-label">
                        Mã vé
                    </div>

                    <div class="ticket-code">
                        @Model.MaVe
                    </div>
                </div>

                <a asp-controller="KhachHang"
                   asp-action="VeCuaToi"
                   class="btn-qr-back">

                    <i class="bi bi-arrow-left"></i>
                    Quay lại danh sách vé
                </a>

            </div>
        }
        else
        {
            <div class="qr-card">

                <h1 class="qr-title">
                    Mã QR tham gia sự kiện
                </h1>

                <p class="qr-subtitle">
                    Xuất trình mã QR khi check-in tại sự kiện.
                </p>

                <!-- GIU NGUYEN MA QR THUC TE -->

                <div class="qr-box">
                    <img src="data:image/png;base64,@Model.QrCodeBase64"
                         alt="Mã QR check-in của vé"
                         width="205"
                         height="205" />
                </div>

                <div class="ticket-code-box">
                    <div class="ticket-code-label">
                        Mã vé
                    </div>

                    <div class="ticket-code">
                        @Model.MaVe
                    </div>
                </div>

                <!-- CANH BAO KHONG CHIA SE MA QR -->

                <div class="qr-warning">
                    <i class="bi bi-shield-exclamation"
                       aria-hidden="true"></i>

                    <span>
                        <strong>Không chia sẻ mã QR này cho người khác.</strong>
                        
                    </span>
                </div>

                <a asp-controller="KhachHang"
                   asp-action="VeCuaToi"
                   class="btn-qr-back">

                    <i class="bi bi-arrow-left"></i>
                    Quay lại danh sách vé
                </a>

            </div>
        }

    </div>
</div>
