@model VeSuKienWeb.Models.KhachHang.MaQrVM

@{
    ViewData["Title"] = "Mã QR vé";
}

<style>
    .qr-page {
        min-height: 100vh;
        background: #f8fafc;
        padding: 42px 16px 56px;
    }

    .qr-wrap {
        max-width: 460px;
        margin: 0 auto;
    }

    .qr-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 28px;
        text-align: center;
        box-shadow: 0 18px 40px rgba(15, 23, 42, .08);
    }

    .qr-title {
        font-size: 24px;
        font-weight: 850;
        color: #0f172a;
        margin-bottom: 6px;
    }

    .qr-subtitle {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 22px;
    }

    .qr-box {
        width: 270px;
        height: 270px;
        margin: 0 auto 20px;
        padding: 14px;
        border-radius: 22px;
        background: #f8fafc;
        border: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .qr-box img {
        max-width: 235px;
        width: 100%;
        height: auto;
        display: block;
    }

    .ticket-code-box {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 16px;
        padding: 13px 16px;
        margin-bottom: 12px;
    }

    .ticket-code-label {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 4px;
    }

    .ticket-code {
        color: #0f172a;
        font-size: 15px;
        font-weight: 850;
        word-break: break-word;
    }

    .qr-note {
        color: #94a3b8;
        font-size: 12px;
        margin-bottom: 22px;
    }

    .btn-back {
        border-radius: 999px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 750;
        width: 100%;
        background: #2563eb;
        color: #ffffff;
        border: none;
        transition: .2s ease;
    }

    .btn-back:hover {
        background: #1d4ed8;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .expired-card {
        background: #ffffff;
        border: 1px solid #fde68a;
        border-radius: 24px;
        padding: 34px 28px;
        text-align: center;
        box-shadow: 0 18px 40px rgba(15, 23, 42, .08);
    }

    .expired-icon {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #fffbeb;
        color: #b45309;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 16px;
    }

    .expired-title {
        color: #0f172a;
        font-size: 22px;
        font-weight: 850;
        margin-bottom: 8px;
    }

    .expired-text {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 18px;
    }

    @@media (max-width: 480px) {
        .qr-card,
        .expired-card {
            padding: 24px 20px;
            border-radius: 20px;
        }

        .qr-box {
            width: 235px;
            height: 235px;
        }

        .qr-box img {
            max-width: 205px;
        }
    }
</style>

<div class="qr-page">
    <div class="qr-wrap">

        @if (Model.HetHieuLuc)
        {
            <div class="expired-card">
                <div class="expired-icon">
                    !
                </div>

                <div class="expired-title">Không thể xem mã QR</div>

                <p class="expired-text">
                    @(!string.IsNullOrEmpty(Model.ThongBao)
                        ? Model.ThongBao
                        : "Sự kiện đã kết thúc nên mã QR không còn được hiển thị.")
                </p>

                <div class="ticket-code-box">
                    <div class="ticket-code-label">Mã vé</div>
                    <div class="ticket-code">@Model.MaVe</div>
                </div>

                <a asp-action="VeCuaToi" class="btn btn-back">
                    Quay lại danh sách vé
                </a>
            </div>
        }
        else
        {
            <div class="qr-card">
                <div class="qr-title">Mã QR vé</div>
                <p class="qr-subtitle">
                    Quét mã này khi check-in tại sự kiện.
                </p>

                <div class="qr-box">
                    <img src="data:image/png;base64,@Model.QrCodeBase64"
                         alt="QR Code" />
                </div>

                <div class="ticket-code-box">
                    <div class="ticket-code-label">Mã vé</div>
                    <div class="ticket-code">@Model.MaVe</div>
                </div>

                <p class="qr-note">
                    QR chứa thông tin: CHECKIN | @Model.VeId | @Model.MaVe
                </p>

                <a asp-action="VeCuaToi" class="btn btn-back">
                    Quay lại danh sách vé
                </a>
            </div>
        }

    </div>
</div>