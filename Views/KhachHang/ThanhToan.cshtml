
@model VeSuKienWeb.Models.KhachHang.ThanhToanKhVM

@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<link rel="stylesheet"
      href="~/css/khachhang-thanh-toan.css"
      asp-append-version="true" />

<div class="payment-page">

<header class="payment-header">
    <div class="payment-order-chip">
        <div class="payment-order-icon">
            <i class="bi bi-receipt"></i>
        </div>

        <div>
            <span>Mã đơn hàng</span>
            <strong>#@Model.DonHangId</strong>
        </div>
    </div>
</header>

    @if (TempData["ThongBao"] != null)
    {
        <div class="payment-alert">
            <i class="bi bi-info-circle-fill"></i>
            <span>@TempData["ThongBao"]</span>
        </div>
    }

    <main class="payment-layout">

        <section class="payment-order-column">

            <div class="payment-card payment-order-card">

                <div class="payment-section-heading">
                    <div class="payment-heading-icon">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>

                    <div>
                        <h3>Thông tin đơn hàng</h3>
                        <p>Danh sách vé bạn đã đăng ký.</p>
                    </div>
                </div>

                <div class="payment-ticket-list">

                    @foreach (var v in Model.Ves)
                    {
                        <article class="payment-ticket-item">

                            <div class="payment-ticket-icon">
                                <i class="bi bi-ticket-perforated-fill"></i>
                            </div>

                            <div class="payment-ticket-info">

                                <strong class="payment-event-name">
                                    @v.TenSuKien
                                </strong>

                                <span class="payment-ticket-type">
                                    @v.TenLoaiVe
                                </span>

                                <div class="payment-ticket-meta">
                                    <span>
                                        <i class="bi bi-upc"></i>
                                        @v.MaVe
                                    </span>

                                    @if (!string.IsNullOrEmpty(v.Hang))
                                    {
                                        <span>
                                            <i class="bi bi-geo-alt"></i>
                                            Ghế @v.Hang@v.Cot
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            <i class="bi bi-globe2"></i>
                                            Sự kiện trực tuyến
                                        </span>
                                    }
                                </div>

                            </div>

                            <div class="payment-ticket-price">
                                @v.GiaVe.ToString("N0") đ
                            </div>

                        </article>
                    }

                </div>

                <div class="payment-order-summary">

                    <div class="payment-summary-row">
                        <span>Số lượng vé</span>
                        <strong>@Model.Ves.Count vé</strong>
                    </div>

                    <div class="payment-summary-total">
                        <div>
                            <span>Tổng thanh toán</span>
                            <small>Đã bao gồm toàn bộ vé trong đơn hàng</small>
                        </div>

                        <strong>
                            @Model.TongTien.ToString("N0") đ
                        </strong>
                    </div>

                </div>

            </div>

            <div class="payment-reminder">
                <i class="bi bi-lightbulb"></i>
                <span>Vui lòng kiểm tra đúng thông tin đơn hàng trước khi thanh toán.</span>
            </div>

        </section>

        <aside class="payment-method-column">



            <section class="payment-method-card payment-vnpay-card">

                <div class="payment-method-card-header">

                    <div class="payment-method-icon vnpay-icon">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>

                    <div class="payment-method-title">
                        <strong>Thanh toán qua VNPay</strong>
                        <span>Nhanh chóng và thuận tiện</span>
                    </div>

                    <span class="payment-method-tag">
                        Phổ biến
                    </span>

                </div>

                <p class="payment-method-description">
                    Chuyển đến cổng thanh toán VNPay để hoàn tất giao dịch trực tuyến.
                </p>

                <div class="payment-method-price">
                    <span>Số tiền thanh toán</span>
                    <strong>@Model.TongTien.ToString("N0") đ</strong>
                </div>

                <a asp-controller="ThanhToan"
                   asp-action="VnPay"
                   asp-route-donHangId="@Model.DonHangId"
                   class="payment-vnpay-button">
                    Thanh toán ngay
                    <i class="bi bi-arrow-right"></i>
                </a>

            </section>

            <section class="payment-method-card payment-qr-card">

                <div class="payment-method-card-header">

                    <div class="payment-method-icon qr-icon">
                        <i class="bi bi-qr-code"></i>
                    </div>

                    <div class="payment-method-title">
                        <strong>Thanh toán bằng mã QR</strong>
                        <span>Sử dụng ứng dụng ngân hàng</span>
                    </div>

                </div>

                <div class="payment-qr-content">

                    <div class="payment-qr-image">
                        <img src="~/qr/maQR.jpg"
                             alt="Mã QR thanh toán" />
                    </div>

                    <div class="payment-qr-instructions">
                        <strong>Quét mã để thanh toán</strong>

                        <p>
                            Mở ứng dụng ngân hàng và sử dụng chức năng quét mã QR.
                        </p>

                        <div class="payment-qr-amount">
                            <span>Số tiền</span>
                            <strong>@Model.TongTien.ToString("N0") đ</strong>
                        </div>
                    </div>

                </div>

                <form asp-action="ThanhToanXacNhan"
                      method="post"
                      class="payment-qr-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.DonHangId" />

                    <button type="submit"
                            class="payment-qr-button">
                        <i class="bi bi-check-circle"></i>
                        Xác nhận thanh toán QR
                    </button>

                </form>

            </section>

        </aside>

    </main>

</div>
