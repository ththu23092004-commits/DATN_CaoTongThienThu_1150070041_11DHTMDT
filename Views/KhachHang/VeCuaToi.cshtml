
@model IEnumerable<VeSuKienWeb.Models.KhachHang.VeCuaToiItemVM>

@{
    ViewData["Title"] = "Vé của tôi";

    var danhSachVe = Model?.ToList()
        ?? new List<VeSuKienWeb.Models.KhachHang.VeCuaToiItemVM>();

    string taiKhoan = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier
    )?.Value ?? User.Identity?.Name ?? "guest";
}

<style>
    /* TRANG VE CUA TOI */

    .tickets-page,
    .tickets-page * {
        box-sizing: border-box;
        font-family: "Be Vietnam Pro", sans-serif;
    }

    .tickets-page {
        min-height: calc(100vh - 170px);
        padding: 22px 0 36px;
        background: transparent;
    }

.tickets-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 15px;
}

    /* HAI TAB */

    .tickets-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 17px;
    }

    .tickets-tab {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 40px;
        padding: 10px 17px;
        border: 1px solid #e2d5e8;
        border-radius: 10px;
        background: rgba(255,255,255,.92);
        color: #302638;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s ease;
    }

    .tickets-tab:hover {
        background: #ffffff;
        border-color: #c4a7d0;
    }

    .tickets-tab.active {
        background: #ffffff;
        border-color: #b98eca;
        color: #563469;
        font-weight: 700;
        box-shadow: 0 4px 13px rgba(70,40,90,.07);
    }

    .tickets-tab-icon {
        font-size: 15px;
    }

    .tickets-tab-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 5px;
        border-radius: 999px;
        background: #b35a89;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
    }

    .tickets-tab-badge[hidden],
    .tickets-panel[hidden] {
        display: none !important;
    }

    /* KHUNG VE */

    .event-ticket {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 155px;
        position: relative;
        width: 100%;
        min-width: 0;
        margin-bottom: 16px;
        overflow: hidden;
        border: 1px solid #e9dfe8;
        border-radius: 17px;
        background: #fffdfb;
        cursor: pointer;
        box-shadow: 0 9px 23px rgba(65, 40, 85, .075);
        transition:
            transform .2s ease,
            box-shadow .2s ease,
            border-color .2s ease;
    }

    .event-ticket:hover {
        transform: translateY(-2px);
        border-color: #cdb6d7;
        box-shadow: 0 13px 28px rgba(65, 40, 85, .12);
    }

    .event-ticket:focus-visible {
        outline: 3px solid #b982ca;
        outline-offset: 3px;
    }

    /* THAN VE: NEN ANH LOANG, CHU, POSTER */

.ticket-main {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 245px;
    align-items: center;
    column-gap: 8px;
    min-width: 0;
    min-height: 205px;
    padding: 15px 14px 15px 18px;
    isolation: isolate;
    overflow: hidden;
    background: #fffaf9;
}

    /* ANH NEN PHU KIN THAN VE */

    .ticket-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .ticket-bg img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 42%;
        opacity: .42;
        filter: blur(.65px) saturate(.75);
        transform: scale(1.03);
    }

    /*
       LOANG TU TRANG BEN TRAI SANG ANH MO BEN PHAI
       BEN TRAI DOC CHU RO, BEN PHAI VAN THAY ANH
    */

    .ticket-main::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(
            90deg,
            rgba(255,253,252,.99) 0%,
            rgba(255,253,252,.97) 29%,
            rgba(255,253,252,.92) 52%,
            rgba(255,253,252,.70) 74%,
            rgba(255,253,252,.40) 100%
        );
    }

    /* THONG TIN BEN TRAI */

    .ticket-content {
        position: relative;
        z-index: 2;
        min-width: 0;
        color: #1f1923;
    }

    .ticket-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        padding: 5px 10px;
        margin-bottom: 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 650;
        line-height: 1.4;
    }

    .status-paid {
        background: #e6f7ec;
        color: #176943;
    }

    .status-unpaid {
        background: #fff3da;
        color: #8f651c;
    }

    .status-cancel {
        background: #eeedf0;
        color: #625b67;
    }

    .status-refund {
        background: #e7f1f7;
        color: #43667c;
    }

    .status-default {
        background: #f1eaf5;
        color: #6e527f;
    }

    .ticket-title {
        margin: 0 0 4px;
        color: #19141c;
        font-size: 16.5px;
        line-height: 1.4;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .ticket-subtitle {
        margin-bottom: 11px;
        color: #4c4352;
        font-size: 11.5px;
        font-weight: 500;
    }

    .ticket-details {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .ticket-line {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        min-width: 0;
        color: #29212d;
        font-size: 11px;
        font-weight: 550;
        line-height: 1.55;
    }

    .ticket-line i {
        flex: 0 0 auto;
        margin-top: 2px;
        color: #765d82;
        font-size: 13px;
    }

.ticket-line span {
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
}

    .ticket-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 9px;
        margin-top: 12px;
        color: #2b2330;
        font-size: 11px;
        line-height: 1.5;
    }

    .ticket-meta-item {
        font-weight: 600;
    }

    .ticket-meta-item.price {
        color: #201725;
        font-weight: 800;
    }

    .ticket-meta-dot {
        color: #98879c;
    }

    /* POSTER RO CUA SU KIEN */

.ticket-photo {
    position: relative;
    z-index: 2;
    width: 245px;
    height: 155px;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, .96);
    border-radius: 11px;
    background: #f4edf5;
    box-shadow: 0 5px 16px rgba(45, 28, 54, .12);
}

    .ticket-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform .25s ease;
    }

    .event-ticket:hover .ticket-photo img {
        transform: scale(1.04);
    }

    .ticket-photo-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        height: 100%;
        background: #f6f0f7;
        color: #897891;
        text-align: center;
        font-size: 10.5px;
    }

    .ticket-photo-placeholder i {
        font-size: 25px;
    }

    /* CUONG VE NEN SIÊU NHAT */

.ticket-stub {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 100%;
    padding: 17px 14px;
    background: linear-gradient(
        145deg,
        #f1e4f8 0%,
        #f9eaf4 52%,
        #fcefe9 100%
    );
}

    /* RANG CUA O GIUA THAN VA CUONG VE */

    .ticket-stub::before {
        content: "";
        position: absolute;
        z-index: 2;
        top: 0;
        bottom: 0;
        left: -6px;
        width: 12px;
        background:
            radial-gradient(
                circle at center,
                #fffdfb 5.5px,
                transparent 6px
            );
        background-repeat: repeat-y;
        background-size: 12px 18px;
        pointer-events: none;
    }

    /* O QR CAN GIUA */

    .stub-qr-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 70px;
        height: 70px;
        border: 1px solid #e4d6ea;
        border-radius: 15px;
        background: #ffffff;
        color: #815b91;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(92,58,107,.06);
        transition:
            background .2s,
            color .2s,
            transform .2s,
            box-shadow .2s;
    }

    .stub-qr-link i {
        font-size: 32px;
        line-height: 1;
    }

    .stub-qr-link:hover,
    .stub-qr-link:focus-visible {
        background: #7e548f;
        color: #ffffff;
        border-color: #7e548f;
        transform: translateY(-2px);
        box-shadow: 0 7px 15px rgba(92,58,107,.14);
    }

    /* VE KHONG CO QR */

    .stub-no-qr {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 70px;
        height: 70px;
        border: 1px solid #eadfea;
        border-radius: 15px;
        background: rgba(255,255,255,.75);
        color: #c4b5c9;
    }

    .stub-no-qr i {
        font-size: 27px;
        line-height: 1;
    }

    /* KHONG CO VE */

    .empty-ticket {
        padding: 42px 24px;
        border: 1px solid #e9ddea;
        border-radius: 17px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 8px 20px rgba(62,37,80,.05);
    }

    .empty-ticket i {
        display: block;
        margin-bottom: 11px;
        color: #ac87bc;
        font-size: 28px;
    }

    .empty-ticket h3 {
        margin: 0 0 7px;
        color: #211a28;
        font-size: 15px;
        font-weight: 700;
    }

    .empty-ticket p {
        margin: 0;
        color: #736879;
        font-size: 12px;
    }

    /* POPUP LOI QR */

    .qr-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(28,22,35,.65);
        backdrop-filter: blur(4px);
    }

    .qr-modal {
        width: 100%;
        max-width: 420px;
        padding: 26px;
        border-radius: 20px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 24px 60px rgba(0,0,0,.22);
    }

    .qr-modal-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        margin: 0 auto 14px;
        border-radius: 50%;
        background: #f7edf8;
        color: #9858a1;
        font-size: 28px;
        font-weight: 800;
    }

    .qr-modal-title {
        margin-bottom: 8px;
        color: #241d2a;
        font-size: 20px;
        font-weight: 700;
    }

    .qr-modal-text {
        margin-bottom: 16px;
        color: #665b6c;
        font-size: 12px;
        line-height: 1.6;
    }

    .qr-modal-btn {
        padding: 10px 20px;
        border: 0;
        border-radius: 999px;
        background: #9558aa;
        color: #ffffff;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
    }

    /* RESPONSIVE */

@@media (max-width: 840px) {
    .ticket-main {
        grid-template-columns: minmax(0, 1fr) 170px;
        gap: 10px;
    }

    .ticket-photo {
        width: 170px;
        height: 132px;
    }
}

    @@media (max-width: 650px) {
        .event-ticket {
            grid-template-columns: minmax(0, 1fr) 85px;
        }

        .ticket-main {
            grid-template-columns: 1fr;
            gap: 11px;
            padding: 15px;
        }

        .ticket-photo {
            width: 100%;
            height: 125px;
        }

        .ticket-main::before {
            background: linear-gradient(
                90deg,
                rgba(255,253,252,.97),
                rgba(255,253,252,.77)
            );
        }

        .ticket-stub {
            padding: 10px;
        }

        .stub-qr-link,
        .stub-no-qr {
            width: 57px;
            height: 57px;
            border-radius: 12px;
        }

        .stub-qr-link i {
            font-size: 26px;
        }
    }

    @@media (max-width: 480px) {
        .tickets-page {
            padding-top: 16px;
        }

        .tickets-container {
            padding: 0 11px;
        }

        .tickets-tabs {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .tickets-tab {
            padding: 9px 7px;
            font-size: 11px;
        }

        .ticket-title {
            font-size: 15px;
        }

        .ticket-line,
        .ticket-meta {
            font-size: 10.5px;
        }

        .ticket-photo {
            height: 108px;
        }
    }
    .ticket-line-address span {
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
    line-height: 1.6;
}
</style>

<div class="tickets-page"
     id="ticketsPage"
     data-owner="@taiKhoan">

    <div class="tickets-container">

        <!-- HAI TAB -->

        <div class="tickets-tabs"
             role="tablist"
             aria-label="Phân loại vé">

            <button type="button"
                    class="tickets-tab active"
                    id="tabActive"
                    role="tab"
                    aria-selected="true"
                    aria-controls="panelActive"
                    data-tab="active">

                <i class="bi bi-ticket-perforated tickets-tab-icon"></i>
                <span>Vé của tôi</span>

                <span class="tickets-tab-badge"
                      id="badgeActive"
                      hidden>0</span>
            </button>

            <button type="button"
                    class="tickets-tab"
                    id="tabHistory"
                    role="tab"
                    aria-selected="false"
                    aria-controls="panelHistory"
                    data-tab="history">

                <i class="bi bi-clock-history tickets-tab-icon"></i>
                <span>Lịch sử vé</span>

                <span class="tickets-tab-badge"
                      id="badgeHistory"
                      hidden>0</span>
            </button>
        </div>

        <section class="tickets-panel"
                 id="panelActive"
                 role="tabpanel"
                 aria-labelledby="tabActive">
        </section>

        <section class="tickets-panel"
                 id="panelHistory"
                 role="tabpanel"
                 aria-labelledby="tabHistory"
                 hidden>
        </section>

        <!-- DANH SACH VE -->

        <div id="ticketsSource" hidden>

            @foreach (var ve in danhSachVe)
            {
                string trangThaiClass = ve.TrangThaiVe switch
                {
                    "DaThanhToan" => "status-paid",
                    "ChuaThanhToan" => "status-unpaid",
                    "Huy" => "status-cancel",
                    "DaHuy" => "status-cancel",
                    "HoanTien" => "status-refund",
                    "DaHoanTien" => "status-refund",
                    _ => "status-default"
                };

                string trangThaiHienThi = ve.TrangThaiVe switch
                {
                    "DaThanhToan" => "Đã thanh toán",
                    "ChuaThanhToan" => "Chưa thanh toán",
                    "Huy" => "Đã hủy",
                    "DaHuy" => "Đã hủy",
                    "HoanTien" => "Đã hoàn tiền",
                    "DaHoanTien" => "Đã hoàn tiền",
                    _ => ve.TrangThaiVe
                };

                string viTriGhe =
                    !string.IsNullOrWhiteSpace(ve.DanhSachGhe)
                        ? ve.DanhSachGhe
                        : (ve.Hang != null && ve.Cot.HasValue
                            ? $"{ve.Hang}{ve.Cot}"
                            : "Ghế tự do");

                bool laLichSu =
                    ve.SuKienDaKetThuc ||
                    ve.TrangThaiVe == "Huy" ||
                    ve.TrangThaiVe == "DaHuy" ||
                    ve.TrangThaiVe == "HoanTien" ||
                    ve.TrangThaiVe == "DaHoanTien";

                string nhomVe = laLichSu ? "history" : "active";

                bool cungNgay =
                    ve.ThoiGianBatDau.Date == ve.ThoiGianKetThuc.Date;

                string thoiGianDienRa = cungNgay
                    ? $"{ve.ThoiGianBatDau:dd/MM/yyyy} | {ve.ThoiGianBatDau:HH:mm} – {ve.ThoiGianKetThuc:HH:mm}"
                    : $"{ve.ThoiGianBatDau:dd/MM/yyyy HH:mm} – {ve.ThoiGianKetThuc:dd/MM/yyyy HH:mm}";

                string chiTietUrl = Url.Action(
                    "ChiTietVe",
                    "KhachHang",
                    new { veId = ve.VeId }
                ) ?? "";

                bool coQrHopLe =
                    ve.LaTrucTiep && ve.DuocXemQr;

                string? anhSuKien = ve.AnhSuKien;

                if (!string.IsNullOrWhiteSpace(anhSuKien))
                {
                    anhSuKien = anhSuKien.Trim().Replace("\\", "/");

                    if (!Uri.TryCreate(
                            anhSuKien,
                            UriKind.Absolute,
                            out var uriAnh) ||
                        (uriAnh.Scheme != Uri.UriSchemeHttp &&
                         uriAnh.Scheme != Uri.UriSchemeHttps))
                    {
                        anhSuKien = Url.Content(
                            anhSuKien.StartsWith("~/")
                                ? anhSuKien
                                : "~/" + anhSuKien.TrimStart('/')
                        );
                    }
                }

                <article class="event-ticket"
                         tabindex="0"
                         role="link"
                         aria-label="Xem chi tiết vé @ve.TenSuKien"
                         title="Bấm để xem chi tiết vé"
                         data-ticket-id="@ve.VeId"
                         data-group="@nhomVe"
                         data-detail-url="@chiTietUrl">

                    <!-- THAN VE -->

                    <div class="ticket-main">

                        <!-- ANH NEN MO -->

                        @if (!string.IsNullOrWhiteSpace(anhSuKien))
                        {
                            <div class="ticket-bg"
                                 aria-hidden="true">

                                <img src="@anhSuKien"
                                     alt=""
                                     loading="lazy" />
                            </div>
                        }

                        <!-- THONG TIN -->

                        <div class="ticket-content">

                            <span class="ticket-status @trangThaiClass">
                                <i class="bi bi-circle-fill"
                                   style="font-size:6px;"></i>
                                @trangThaiHienThi
                            </span>

                            <h3 class="ticket-title">
                                @ve.TenSuKien
                            </h3>

                            <div class="ticket-subtitle">
                                @(ve.LaTrucTiep
                                    ? "Trực tiếp"
                                    : ve.LaTrucTuyen
                                        ? "Trực tuyến"
                                        : ve.TenLoaiSuKien)
                            </div>

                            <div class="ticket-details">

                                <div class="ticket-line">
                                    <i class="bi bi-calendar3"></i>
                                    <span>@thoiGianDienRa</span>
                                </div>

                                @if (ve.LaTrucTiep)
                                {
<div class="ticket-line ticket-line-address">
    <i class="bi bi-geo-alt"></i>
    <span>
        @ve.DiaDiem
        @if (!string.IsNullOrWhiteSpace(ve.DiaChi))
        {
            <text> · @ve.DiaChi</text>
        }
    </span>
</div>
                                }
                                else if (ve.LaTrucTuyen)
                                {
                                    <div class="ticket-line">
                                        <i class="bi bi-camera-video"></i>

                                        <span>
                                            Trực tuyến

                                            @if (!string.IsNullOrWhiteSpace(ve.OnlineNenTang))
                                            {
                                                <text> · @ve.OnlineNenTang</text>
                                            }
                                        </span>
                                    </div>
                                }

                            </div>

                            <div class="ticket-meta">

                                @if (!string.IsNullOrWhiteSpace(ve.TenLoaiVe))
                                {
                                    <span class="ticket-meta-item">
                                        @ve.TenLoaiVe
                                    </span>

                                    <span class="ticket-meta-dot">•</span>
                                }

                                @if (ve.LaTrucTiep)
                                {
                                    <span class="ticket-meta-item">
                                        @(viTriGhe == "Ghế tự do"
                                            ? "Ghế tự do"
                                            : $"Ghế {viTriGhe}")
                                    </span>

                                    <span class="ticket-meta-dot">•</span>
                                }

                                <span class="ticket-meta-item price">
                                    @ve.GiaVe.ToString("N0") đ
                                </span>
                            </div>
                        </div>

                        <!-- POSTER RO -->

                        <div class="ticket-photo">
                            @if (!string.IsNullOrWhiteSpace(anhSuKien))
                            {
                                <img src="@anhSuKien"
                                     alt="Ảnh sự kiện @ve.TenSuKien"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="ticket-photo-placeholder">
                                    <i class="bi bi-image"></i>
                                    <span>Ảnh sự kiện</span>
                                </div>
                            }
                        </div>

                    </div>

                    <!-- CUONG VE NEN NHAT -->

                    <div class="ticket-stub">

                        @if (coQrHopLe)
                        {
                            <a asp-controller="KhachHang"
                               asp-action="XemMaQr"
                               asp-route-veId="@ve.VeId"
                               class="stub-qr-link"
                               title="Xem mã QR"
                               aria-label="Xem mã QR vé @ve.TenSuKien">

                                <i class="bi bi-qr-code"></i>

                            </a>
                        }
                        else
                        {
                            <div class="stub-no-qr"
                                 title="Vé không có mã QR khả dụng"
                                 aria-hidden="true">

                                <i class="bi bi-ticket-perforated"></i>

                            </div>
                        }

                    </div>

                </article>
            }
        </div>
    </div>

    @if (TempData["QrError"] != null)
    {
        <div class="qr-modal-backdrop"
             id="qrModal">

            <div class="qr-modal">

                <div class="qr-modal-icon">!</div>

                <div class="qr-modal-title">
                    Không thể xem mã QR
                </div>

                <div class="qr-modal-text">
                    @TempData["QrError"]
                </div>

                <button type="button"
                        class="qr-modal-btn"
                        onclick="document.getElementById('qrModal').style.display='none'">
                    Đã hiểu
                </button>

            </div>
        </div>
    }

</div>

<script>
(function () {
    "use strict";

    const page = document.getElementById("ticketsPage");
    if (!page) return;

    const source = document.getElementById("ticketsSource");

    const panelActive = document.getElementById("panelActive");
    const panelHistory = document.getElementById("panelHistory");

    const tabActive = document.getElementById("tabActive");
    const tabHistory = document.getElementById("tabHistory");

    const badgeActive = document.getElementById("badgeActive");
    const badgeHistory = document.getElementById("badgeHistory");

    const owner = page.dataset.owner || "guest";
    const storageKey = "ve_cua_toi_da_xem_v1_" + owner;

    let seen = {};

    try {
        const saved = localStorage.getItem(storageKey);

        if (saved) {
            const parsed = JSON.parse(saved);

            if (
                parsed &&
                typeof parsed === "object" &&
                !Array.isArray(parsed)
            ) {
                seen = parsed;
            }
        }
    } catch (error) {
        seen = {};
    }

    function saveSeen() {
        try {
            localStorage.setItem(storageKey, JSON.stringify(seen));
        } catch (error) {
            // Storage khong kha dung van chuyen tab duoc.
        }
    }

    const tickets = Array.from(
        source.querySelectorAll(".event-ticket")
    );

    const activeTickets = [];
    const historyTickets = [];

    tickets.forEach(function (ticket) {
        const group = ticket.dataset.group;
        const id = ticket.dataset.ticketId;

        ticket.dataset.seenKey = group + "_" + id;

        if (group === "history") {
            panelHistory.appendChild(ticket);
            historyTickets.push(ticket);
        } else {
            panelActive.appendChild(ticket);
            activeTickets.push(ticket);
        }

        /* BAM THAN VE MO CHI TIET */

        ticket.addEventListener("click", function (event) {
            if (event.target.closest(
                "a, button, input, select, textarea"
            )) {
                return;
            }

            const url = ticket.dataset.detailUrl;

            if (url) {
                window.location.assign(url);
            }
        });

        ticket.addEventListener("keydown", function (event) {
            if (event.target !== ticket) return;

            if (
                event.key === "Enter" ||
                event.key === " "
            ) {
                event.preventDefault();

                const url = ticket.dataset.detailUrl;

                if (url) {
                    window.location.assign(url);
                }
            }
        });
    });

    source.remove();

    /* KHONG CO VE */

    function createEmptyMessage(title, description) {
        const empty = document.createElement("div");
        empty.className = "empty-ticket";

        const icon = document.createElement("i");
        icon.className = "bi bi-ticket-perforated";
        icon.setAttribute("aria-hidden", "true");

        const heading = document.createElement("h3");
        heading.textContent = title;

        const text = document.createElement("p");
        text.textContent = description;

        empty.append(icon, heading, text);
        return empty;
    }

    if (activeTickets.length === 0) {
        panelActive.appendChild(
            createEmptyMessage(
                "Bạn chưa có vé đang sử dụng",
                "Những vé còn hiệu lực sẽ hiển thị tại đây."
            )
        );
    }

    if (historyTickets.length === 0) {
        panelHistory.appendChild(
            createEmptyMessage(
                "Chưa có lịch sử vé",
                "Vé đã hủy, hoàn tiền hoặc sự kiện đã kết thúc sẽ hiển thị tại đây."
            )
        );
    }

    /* SO THONG BAO */

    function updateBadges() {
        const activeUnread = activeTickets.filter(
            function (ticket) {
                return !seen[ticket.dataset.seenKey];
            }
        ).length;

        const historyUnread = historyTickets.filter(
            function (ticket) {
                return !seen[ticket.dataset.seenKey];
            }
        ).length;

        badgeActive.textContent =
            activeUnread > 99 ? "99+" : String(activeUnread);

        badgeHistory.textContent =
            historyUnread > 99 ? "99+" : String(historyUnread);

        badgeActive.hidden = activeUnread === 0;
        badgeHistory.hidden = historyUnread === 0;
    }

    function markGroupAsSeen(group) {
        const list =
            group === "history"
                ? historyTickets
                : activeTickets;

        list.forEach(function (ticket) {
            seen[ticket.dataset.seenKey] = true;
        });

        saveSeen();
        updateBadges();
    }

    /* CHUYEN TAB */

    function showTab(group, markSeen) {
        const isActive = group === "active";

        panelActive.hidden = !isActive;
        panelHistory.hidden = isActive;

        tabActive.classList.toggle("active", isActive);
        tabHistory.classList.toggle("active", !isActive);

        tabActive.setAttribute(
            "aria-selected",
            String(isActive)
        );

        tabHistory.setAttribute(
            "aria-selected",
            String(!isActive)
        );

        if (markSeen) {
            markGroupAsSeen(group);
        }
    }

    tabActive.addEventListener("click", function () {
        showTab("active", true);
    });

    tabHistory.addEventListener("click", function () {
        showTab("history", true);
    });

    showTab("active", false);
    updateBadges();
})();
</script>
